<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        xmlns:models="clr-namespace:UniversalDownloader.Models;assembly=Downloader.Core"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
        x:Class="UniversalDownloader.Avalonia.MainWindow"
        Title="Universal Downloader"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="68"/>
        </Grid.ColumnDefinitions>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="0">
            <!-- MAIN VIEW (Downloader) -->
            <ScrollViewer x:Name="MainScrollViewer" IsVisible="True" Margin="24,20,12,20">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Universal Downloader" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Fast, Multi-Source Media &amp; Music Downloader" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="UpdateAvailableButton" Classes="primary" Height="32" Padding="12,0" Background="#059669" BorderBrush="#10B981" IsVisible="False" Click="UpdateAvailableButton_Click" ToolTip.Tip="New version available! Click to update.">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✨ Update" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="UpdateBadgeTextBlock" Text=" v1.0.9" FontSize="11" Foreground="#D1FAE5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="StatusBadgeTextBlock" Text="Ready" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- URL Input Grid -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox x:Name="UrlTextBox" Grid.Column="0" Watermark="Paste YouTube, Spotify, SoundCloud, TikTok, Instagram, Twitter/X, or direct URL..." Height="46" FontSize="13" CornerRadius="10" VerticalContentAlignment="Center" KeyDown="UrlTextBox_KeyDown"/>
                                <Button x:Name="PasteButton" Grid.Column="1" Classes="secondary" Content="📋 Paste" Height="46" Margin="10,0,0,0" Click="PasteButton_Click"/>
                                <Button x:Name="StartDownloadButton" Grid.Column="2" Classes="primary" Content="⬇ Download" Height="46" Margin="10,0,0,0" Click="StartDownloadButton_Click"/>
                            </Grid>

                            <!-- Controls Row -->
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Format:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="FormatComboBox" SelectedIndex="0" Height="36" Width="170">
                                        <ComboBoxItem Content="🎬 Best Video (MP4)"/>
                                        <ComboBoxItem Content="🎵 Best Audio (MP3)"/>
                                        <ComboBoxItem Content="🎵 High Quality (FLAC)"/>
                                        <ComboBoxItem Content="🎵 High Quality (M4A)"/>
                                        <ComboBoxItem Content="🎬 1080p Full HD"/>
                                        <ComboBoxItem Content="🎬 720p HD"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <CheckBox x:Name="EnableTrimCheckBox" Content="✂ Trim Clip" IsCheckedChanged="EnableTrimCheckBox_CheckedChanged"/>
                                    <TextBox x:Name="TrimStartTextBox" Watermark="00:00:00" Width="85" Height="34" IsVisible="False"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" IsVisible="{Binding #TrimStartTextBox.IsVisible}"/>
                                    <TextBox x:Name="TrimEndTextBox" Watermark="00:01:30" Width="85" Height="34" IsVisible="{Binding #TrimStartTextBox.IsVisible}"/>
                                </StackPanel>

                                <Button x:Name="AddToQueueButton" Classes="secondary" Content="➕ Add to Queue" Height="36" Click="AddToQueueButton_Click"/>
                            </WrapPanel>

                            <!-- Live Progress Area -->
                            <Border x:Name="ProgressBorder" Background="#181822" CornerRadius="12" Padding="16,12" IsVisible="False">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="ProgressStatusTextBlock" Text="Downloading..." FontWeight="SemiBold" FontSize="13" Foreground="#818CF8"/>
                                        <TextBlock Grid.Column="1" x:Name="ProgressPercentTextBlock" Text="0%" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                    </Grid>
                                    <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#6366F1" Background="#262630" CornerRadius="4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Quick Discovery Cards -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🚀 Quick Actions &amp; Discovery" FontWeight="Bold" FontSize="15" Foreground="White"/>
                            <Grid ColumnDefinitions="*,*,*">
                                <Button Grid.Column="0" Classes="secondary" Margin="0,0,8,0" Height="70" Click="NavSearch_Click">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="🔍 Search Hub" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="YouTube &amp; SoundCloud search" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="secondary" Margin="4,0,4,0" Height="70" Click="NavSpotify_Click">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="🟢 Spotify Batch" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Import CSV or Playlists" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="secondary" Margin="8,0,0,0" Height="70" Click="NavQueue_Click">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="📋 Queue Manager" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="View active &amp; pending downloads" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SEARCH HUB VIEW -->
            <ScrollViewer x:Name="SearchScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔍 Multi-Source Search Hub" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Search music tracks or full YouTube video search with instant 0ms tab switching" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                    </Grid>

                    <!-- Search Header Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <!-- Mode Selection Tabs -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <RadioButton x:Name="SearchModeSmartMusicTab" Classes="chip" Content="🎵 Smart Music Hub" IsChecked="True" Click="SearchModeTab_Click" Tag="SmartMusic"/>
                                <RadioButton x:Name="SearchModeRealYouTubeTab" Classes="chip" Content="📺 Real YouTube Search" Click="SearchModeTab_Click" Tag="RealYouTube"/>
                            </StackPanel>

                            <!-- Input Grid -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox x:Name="SearchQueryTextBox" Grid.Column="0" Watermark="Search track, artist, music name or album..." Height="46" FontSize="13" CornerRadius="10" VerticalContentAlignment="Center" KeyDown="SearchQueryTextBox_KeyDown"/>
                                <Button x:Name="ShazamIdentifyButton" Grid.Column="1" Classes="secondary" Content="🎙️ Shazam (5s)" Height="46" Margin="10,0,0,0" Click="ShazamIdentifyButton_Click"/>
                                <Button x:Name="ExecuteSearchButton" Grid.Column="2" Classes="primary" Content="🔍 Search" Height="46" Margin="10,0,0,0" Click="ExecuteSearchButton_Click"/>
                            </Grid>

                            <!-- Source filter -->
                            <StackPanel x:Name="SearchPlatformFilterPanel" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Source:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <RadioButton x:Name="SearchFilterAll" Classes="chip" Content="All Sources" IsChecked="True" Click="SearchFilter_Click" Tag="All"/>
                                <RadioButton x:Name="SearchFilterYouTube" Classes="chip" Content="🔴 YouTube" Click="SearchFilter_Click" Tag="YouTube"/>
                                <RadioButton x:Name="SearchFilterSoundCloud" Classes="chip" Content="🟠 SoundCloud" Click="SearchFilter_Click" Tag="SoundCloud"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SearchStatsTextBlock" Text="" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <!-- Search Results -->
                    <ItemsControl x:Name="SearchResultsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:SearchResultItem">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="90,*,Auto">
                                        <Image Grid.Column="0" asyncImageLoader:ImageLoader.Source="{Binding ThumbnailUrl}" Width="80" Height="50" Stretch="UniformToFill"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ArtistOrChannel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DurationString}" FontSize="11" Foreground="#818CF8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Classes="primary" Content="⬇ Download" Click="SearchItemDownload_Click" Tag="{Binding}"/>
                                            <Button Classes="secondary" Content="➕ Queue" Click="SearchItemAddToQueue_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- QUEUE VIEW -->
            <ScrollViewer x:Name="QueueScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="📋 Download Queue Manager" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Grid.Column="1" Classes="secondary" Content="🗑️ Clear Finished" Margin="0,0,8,0" Click="QueueClearFinished_Click"/>
                        <Button Grid.Column="2" Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                    </Grid>

                    <ItemsControl x:Name="QueueItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:DownloadQueueItem">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#6366F1" Background="#262630"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="✖ Cancel" Margin="12,0,0,0" VerticalAlignment="Center" Click="QueueCancelItem_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- HISTORY VIEW -->
            <ScrollViewer x:Name="HistoryScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="📜 Download History" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Grid.Column="1" Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                    </Grid>

                    <ItemsControl x:Name="HistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:DownloadHistoryItem">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="secondary" Content="📂 Open Folder" Click="HistoryOpenFolder_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- LIVE STREAM / DJ SCRAPER VIEW -->
            <ScrollViewer x:Name="LiveStreamScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📻 Live Stream / DJ Scraper" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Continuously recognizes songs playing on your PC in real-time without duplicates" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="LiveStreamDownloadAllButton" Classes="primary" Content="⬇ Download All" Click="LiveStreamDownloadAll_Click" IsEnabled="False"/>
                            <Button Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Control Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Grid.Column="0" x:Name="LiveStreamToggleButton" Classes="primary" Content="🎙️ Start Listening (PC Audio)" Height="44" Padding="18,0" Click="LiveStreamToggle_Click"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0" Spacing="4">
                                <TextBlock x:Name="LiveStreamStatusTextBlock" Text="⚪ Ready — Press Start Listening or F9" FontWeight="SemiBold" FontSize="13"/>
                                <ProgressBar x:Name="LiveStreamAudioProgressBar" Height="4" Minimum="0" Maximum="1" Value="0" Foreground="#10B981" Background="#262630"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="LiveStreamCountTextBlock" Text="0 tracks" FontWeight="Bold" FontSize="13" Foreground="#10B981" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Real-Time List -->
                    <ItemsControl x:Name="LiveStreamItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:LiveDetectedTrackItem">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Background="#242432" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="primary" Content="⬇ Download" Click="LiveStreamDownloadSingle_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS VIEW -->
            <ScrollViewer x:Name="SettingsScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="⚙️ Application Settings" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <Button Grid.Column="1" Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                    </Grid>

                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="📁 Download Directory" FontWeight="Bold" FontSize="14"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="DownloadPathTextBox" Grid.Column="0" IsReadOnly="True" Height="40" CornerRadius="8"/>
                                <Button Grid.Column="1" Classes="secondary" Content="Browse..." Margin="8,0,0,0" Height="40" Click="BrowseDownloadPath_Click"/>
                            </Grid>

                            <CheckBox x:Name="DownloadLyricsCheckBox" Content="📝 Auto-download companion .lrc lyrics file (Off by default)"/>
                            <CheckBox x:Name="AutoUpdateDependenciesCheckBox" Content="🔄 Auto-update yt-dlp on startup" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Application Updates Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="🚀 Application Updates" FontWeight="Bold" FontSize="14"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Universal Downloader" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                        <TextBlock x:Name="SettingsAppVersionText" Text=" (v1.0.16)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsUpdateStatusText" Text="Check for newer releases on GitHub" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Content="🔄 Check for Updates" Height="36" Padding="14,0" Click="CheckForUpdates_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SMART VIDEO COMPRESSOR VIEW -->
            <ScrollViewer x:Name="CompressorScrollViewer" IsVisible="False" Margin="24,20,12,20">
                <StackPanel Spacing="16" MaxWidth="800">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="🗜️ Smart Video Compressor" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Visually lossless compression by default (zero quality loss), or custom limits &amp; codecs." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Content="✖ Close" Click="BackToMain_Click"/>
                    </Grid>

                    <!-- Drag & Drop Zone -->
                    <Border x:Name="AvaloniaCompressorDropZone" 
                            Background="#141418" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="2" 
                            CornerRadius="16" 
                            Padding="28,20" 
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="🗜️" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag &amp; Drop video files here to compress" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="or click 'Add Video Files' below (MP4, MKV, MOV, WebM, AVI, FLV, TS, WMV)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Add Files & Actions Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="VIDEOS TO COMPRESS" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AvaloniaCompressorTotalEtaText" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary" Content="📂 Add Video Files" Click="AvaloniaCompressorBrowse_Click"/>
                                    <Button Classes="secondary" Content="Clear List" Click="AvaloniaCompressorClear_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Items List -->
                            <TextBlock x:Name="AvaloniaCompressorEmptyText" Text="Drop or click 'Add Video Files' to select videos to compress." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16"/>
                            <ItemsControl x:Name="AvaloniaCompressorItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#16161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding OriginalSizeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="➔" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding IsCompleted}"/>
                                                        <TextBlock Text="{Binding CompressedSizeFormatted}" FontSize="11" FontWeight="Bold" Foreground="#10B981" IsVisible="{Binding IsCompleted}"/>
                                                        <TextBlock Text="{Binding SavingsFormatted}" FontSize="11" FontWeight="Bold" Foreground="#10B981" IsVisible="{Binding IsCompleted}"/>
                                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#818CF8"/>
                                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding IsCompleted}"/>
                                                        <TextBlock Text="{Binding DurationFormatted}" FontSize="11" Foreground="#A1A1AA" IsVisible="{Binding IsCompleted}"/>
                                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" IsVisible="{Binding IsCompressing}"/>
                                                        <TextBlock Text="{Binding TimeRemainingFormatted}" FontSize="11" Foreground="#38BDF8" IsVisible="{Binding IsCompressing}"/>
                                                    </StackPanel>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Background="#262630" Foreground="#06B6D4" CornerRadius="2" IsVisible="{Binding IsCompressing}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="secondary" Content="✕" Width="28" Height="28" Padding="0" Click="AvaloniaCompressorRemove_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Compression Settings Card -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="⚙️ Compression Parameters" FontWeight="Bold" FontSize="14" Foreground="White"/>

                            <!-- Preset Mode -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Compression Mode:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="AvaloniaCompressorPresetComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AvaloniaCompressorPreset_Changed">
                                    <ComboBoxItem Content="✨ Visually Lossless (Zero Noticeable Quality Loss - Default)"/>
                                    <ComboBoxItem Content="⚖️ Balanced (Web &amp; Discord Sharing)"/>
                                    <ComboBoxItem Content="🗜️ Maximum Compression (Smallest File Size)"/>
                                    <ComboBoxItem Content="🎯 Target File Size Limit (e.g. 25MB Discord)"/>
                                    <ComboBoxItem Content="⚙️ Custom Parameters"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Hardware Device (GPU vs CPU) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Encoding Device:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="AvaloniaCompressorDeviceComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="⚡ Hardware GPU (NVIDIA NVENC / AMD AMF / Intel QSV / Apple VideoToolbox - Recommended)"/>
                                    <ComboBoxItem Content="💻 Software CPU (Universal Compatibility, Slower)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Dropdown Menu for Detailed Parameters & Output Destination -->
                            <Border x:Name="AvaloniaCompressorDropdownBorder"
                                    Background="#141416"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel Spacing="0">
                                    <!-- Dropdown Header Button -->
                                    <Button x:Name="AvaloniaCompressorToggleSettingsButton"
                                            Click="AvaloniaCompressorToggleSettings_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="16,12"
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Advanced Parameters &amp; Destination" 
                                                           FontSize="13" 
                                                           FontWeight="SemiBold" 
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="(CRF, Codec, FPS, Audio, Folder)" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                                           FontSize="11.5" 
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="AvaloniaCompressorDropdownArrow" 
                                                       Grid.Column="1" 
                                                       Text="▼" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="12" 
                                                       FontWeight="Bold" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- Collapsible Dropdown Content -->
                                    <Border x:Name="AvaloniaCompressorDetailedSettingsPanel"
                                            IsVisible="False"
                                            Padding="16,14,16,16"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <StackPanel Spacing="16">
                                            <!-- Target Size Box -->
                                            <StackPanel x:Name="AvaloniaCompressorTargetSizePanel" Spacing="6" IsVisible="False">
                                                <TextBlock Text="Target File Size (MB):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="120,Auto,*">
                                                    <TextBox x:Name="AvaloniaCompressorTargetSizeTextBox" Grid.Column="0" Text="25" Height="36" CornerRadius="8"/>
                                                    <TextBlock Grid.Column="1" Text="MB per video" VerticalAlignment="Center" Margin="10,0,16,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Classes="secondary" Content="25 MB" Tag="25" Click="AvaloniaTargetSizePreset_Click"/>
                                                        <Button Classes="secondary" Content="50 MB" Tag="50" Click="AvaloniaTargetSizePreset_Click"/>
                                                        <Button Classes="secondary" Content="100 MB" Tag="100" Click="AvaloniaTargetSizePreset_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- CRF Quality Slider -->
                                            <StackPanel x:Name="AvaloniaCompressorCrfPanel" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Quality Level (CRF):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1" x:Name="AvaloniaCompressorCrfText" Text="20 (Visually Lossless)" FontSize="12" FontWeight="SemiBold" Foreground="#06B6D4"/>
                                                </Grid>
                                                <Slider x:Name="AvaloniaCompressorCrfSlider" Minimum="16" Maximum="36" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AvaloniaCompressorCrfSlider_ValueChanged"/>
                                            </StackPanel>

                                            <!-- Codec & Resolution -->
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                    <TextBlock Text="Video Codec:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox x:Name="AvaloniaCompressorCodecComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="H.264 / AVC (Universal)"/>
                                                        <ComboBoxItem Content="H.265 / HEVC (High Efficiency)"/>
                                                        <ComboBoxItem Content="AV1 (Ultra Compression)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <TextBlock Text="Resolution Limit:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox x:Name="AvaloniaCompressorResolutionComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Original Resolution"/>
                                                        <ComboBoxItem Content="1080p Full HD"/>
                                                        <ComboBoxItem Content="720p HD"/>
                                                        <ComboBoxItem Content="480p SD"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- FPS & Audio -->
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                    <TextBlock Text="Frame Rate (FPS):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox x:Name="AvaloniaCompressorFpsComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Original FPS"/>
                                                        <ComboBoxItem Content="Cap 60 FPS"/>
                                                        <ComboBoxItem Content="Cap 30 FPS"/>
                                                        <ComboBoxItem Content="Cap 24 FPS"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                    <TextBlock Text="Audio Handling:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <ComboBox x:Name="AvaloniaCompressorAudioComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Passthrough (Lossless Copy)"/>
                                                        <ComboBoxItem Content="AAC 128 kbps (Compact)"/>
                                                        <ComboBoxItem Content="AAC 192 kbps (HQ Audio)"/>
                                                        <ComboBoxItem Content="Mute (Strip Audio)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Output Folder -->
                                            <StackPanel Spacing="6">
                                                <CheckBox x:Name="AvaloniaCompressorAutoFolderCheckBox" 
                                                          Content="📁 Save into 'Compressed' subfolder in source directory (Default)" 
                                                          IsChecked="True" 
                                                          FontSize="12" 
                                                          FontWeight="SemiBold" 
                                                          IsCheckedChanged="AvaloniaCompressorAutoFolder_CheckedChanged"/>
                                                <TextBlock Text="Output Folder:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBox x:Name="AvaloniaCompressorFolderTextBox" Grid.Column="0" IsReadOnly="True" Text="Automatic: [Source Directory]/Compressed" Height="40" CornerRadius="8"/>
                                                    <Button Grid.Column="1" Classes="secondary" Content="Browse Custom..." Margin="8,0,0,0" Height="40" Click="AvaloniaCompressorBrowseFolder_Click"/>
                                                    <Button Grid.Column="2" Classes="secondary" Content="Reset" Margin="8,0,0,0" Height="40" Click="AvaloniaCompressorResetFolder_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Start Button -->
                            <Button x:Name="AvaloniaStartCompressButton" Classes="primary" Content="🗜️ Start Video Compression" Height="44" HorizontalAlignment="Center" Width="260" Click="AvaloniaStartCompress_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ANIME SERIES BATCH DOWNLOAD OVERLAY -->
            <Grid x:Name="AnimeDrawerGrid" Background="#B3000000" IsVisible="False" ZIndex="998">
                <Border Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="#F43F5E" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Width="560" 
                        MaxHeight="680" 
                        Padding="24" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <!-- Header -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0" Width="60" Height="84" CornerRadius="8" Background="#20202A" ClipToBounds="True" Margin="0,0,14,0">
                                <Image x:Name="AnimeDrawerPosterImage" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="AnimeDrawerCategoryText" Text="🎬 СЕРИАЛ / ФИЛЬМ" Foreground="#F43F5E" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="AnimeDrawerTitleText" Text="Название Аниме" FontSize="17" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AnimeDrawerMetaText" Text="2024 • 24 серий • ⭐ 8.5" Foreground="#10B981" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="secondary" Content="✕" Width="30" Height="30" Click="AnimeDrawerClose_Click"/>
                        </Grid>

                        <!-- Dubbing Selector -->
                        <Border Background="#16161E" CornerRadius="10" Padding="12" BorderBrush="#272732" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🎙️ Озвучка:" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="Выбор перевода" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="AnimeDubsComboBox" Grid.Column="1" Height="34" HorizontalAlignment="Stretch" SelectionChanged="AnimeDubsComboBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- Episodes Header & Controls -->
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="AnimeSelectedCountText" Grid.Column="0" Text="Выбрано: 24 из 24" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="secondary" Content="✓ Все" Height="30" Padding="10,0" FontSize="11" Margin="0,0,8,0" Click="AnimeSelectAll_Click"/>
                            <Button Grid.Column="2" Classes="secondary" Content="Снять" Height="30" Padding="10,0" FontSize="11" Click="AnimeDeselectAll_Click"/>
                        </Grid>

                        <!-- Scrollable Episodes List -->
                        <Border Background="#0D0D12" CornerRadius="8" Padding="8" BorderBrush="#22222E" BorderThickness="1" MaxHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AnimeEpisodesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161E" CornerRadius="6" Padding="10,6" Margin="0,0,0,4" BorderBrush="#242432" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="6,2" BorderBrush="#38BDF8" BorderThickness="1">
                                                        <TextBlock Text="{Binding QualityBadge}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer Actions -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="AnimeDrawerFallbackText" Text="Авто: 1080p (Cinemar/VideoCDN/Alloha)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"/>
                                <CheckBox x:Name="AnimeDownloadSubsCheckBox" 
                                          Content="Скачивать субтитры" 
                                          FontSize="10.5" 
                                          Foreground="{StaticResource TextSecondaryBrush}" 
                                          IsChecked="True" 
                                          Margin="0,2,0,0"
                                          ToolTip.Tip="Автоматически скачивает файл субтитров (.vtt / .srt) при наличии"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Content="Отмена" Height="36" Padding="14,0" FontSize="11" Margin="0,0,8,0" Click="AnimeDrawerClose_Click"/>
                            <Button x:Name="AnimeDownloadSelectedButton" Grid.Column="2" Classes="primary" Content="⬇ Скачать выбранные" Height="36" Padding="16,0" FontSize="11.5" FontWeight="Bold" Background="#E11D48" BorderBrush="#F43F5E" Click="AnimeDownloadSelected_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- UPDATE MODAL DIALOG OVERLAY -->
            <Grid x:Name="UpdateDialogOverlay" Background="#B3000000" IsVisible="False" ZIndex="999">
                <Border Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="#38BDF8" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Width="500" 
                        MaxHeight="600" 
                        Padding="24" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <StackPanel Spacing="14">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🚀" FontSize="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="New Version Available!" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="UpdateDialogCurrentVersionTextBlock" Text="v1.0.8" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text=" ➔ " FontSize="12" Foreground="#38BDF8" FontWeight="Bold"/>
                                    <TextBlock Text="Latest: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="UpdateDialogLatestVersionTextBlock" Text="v1.0.9" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Content="✕" Width="30" Height="30" Click="UpdateDialogClose_Click"/>
                        </Grid>

                        <!-- Release Title / Date -->
                        <Border Background="#16161E" CornerRadius="10" Padding="12" BorderBrush="#272732" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="UpdateDialogReleaseTitleTextBlock" Text="Release Title" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UpdateDialogReleaseDateTextBlock" Text="Published: 2026-08-24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Changelog Notes -->
                        <TextBlock Text="📋 What's New:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        <Border Background="#0D0D12" CornerRadius="8" Padding="12" BorderBrush="#22222E" BorderThickness="1" MaxHeight="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateDialogNotesTextBlock" Text="Release notes..." TextWrapping="Wrap" FontSize="11.5" Foreground="#CBD5E1" LineHeight="17"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Download Progress -->
                        <StackPanel x:Name="UpdateProgressPanel" Spacing="4" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="UpdateProgressStatusTextBlock" Text="Downloading update..." FontSize="11.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" x:Name="UpdateProgressPercentTextBlock" Text="0%" FontSize="11.5" Foreground="White" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="UpdateDownloadProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#262630"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                            <Button Grid.Column="0" Classes="secondary" Content="🌐 View on GitHub" Height="38" Padding="12,0" FontSize="11.5" Click="UpdateDialogViewGitHub_Click"/>
                            <Button Grid.Column="1" Classes="secondary" Content="Later" Height="38" Padding="16,0" FontSize="11.5" Margin="8,0" Click="UpdateDialogClose_Click"/>
                            <Button x:Name="UpdateDialogApplyButton" Grid.Column="2" Classes="primary" Content="⬇ Update &amp; Restart" Height="38" Padding="16,0" FontSize="12" FontWeight="Bold" Background="#059669" BorderBrush="#10B981" Click="UpdateDialogApply_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- RIGHT NAVIGATION RAIL -->
        <Border Grid.Column="1" Background="#0E0E14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Center" Spacing="16" HorizontalAlignment="Center">
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Main Downloader" Click="NavMain_Click">
                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Search Hub" Click="NavSearch_Click">
                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Shazam Song Recognition" Click="NavShazam_Click">
                    <TextBlock Text="🎙️" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Live Stream / DJ Scraper [F9]" Click="NavLiveStream_Click">
                    <TextBlock Text="📻" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Queue Manager" Click="NavQueue_Click">
                    <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Smart Video Compressor" Click="NavCompressor_Click">
                    <TextBlock Text="🗜️" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Download History" Click="NavHistory_Click">
                    <TextBlock Text="📜" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
                <Button Classes="secondary" Width="46" Height="46" ToolTip.Tip="Settings" Click="NavSettings_Click">
                    <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
