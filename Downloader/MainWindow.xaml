<Window x:Class="UniversalDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UniversalDownloader"
        mc:Ignorable="d"
        Title="Universal File Downloader" Height="850" Width="900"
        MinHeight="680" MinWidth="700"
        Icon="akashi.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter, Segoe UI, Arial"
        FontWeight="Normal"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="MainWindow_Loaded"
        StateChanged="MainWindow_StateChanged"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      CornerRadius="0"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- Dark Mode Color Palette -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#8B5CF6"/> <!-- Vibrant Purple -->
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#EC4899"/> <!-- Vibrant Pink -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/> <!-- Green for completed state -->
        
        <!-- Surface and Backgrounds -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#09090B"/> <!-- Very Dark Gray -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#18181B"/> <!-- Slightly lighter -->
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#27272A"/> 
        
        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
        
        <!-- Borders -->
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        
        <SolidColorBrush x:Key="ScrollBarThumbIdleBrush" Color="#52525B"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#71717A"/>
        <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#8B5CF6"/>

        <!-- Drop Shadows -->
        <DropShadowEffect x:Key="GlowEffect" BlurRadius="25" ShadowDepth="0" Color="#8B5CF6" Opacity="0.4"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="4" Color="#000000" Opacity="0.6"/>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="30" ShadowDepth="8" Color="#000000" Opacity="0.7"/>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#15FFFFFF" Offset="0"/>
            <GradientStop Color="#05FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern Button Style -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource GlowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.1"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MinimalistCancelButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Foreground" Value="#F43F5E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Width" Value="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Content" Value="✕"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Modern Danger / Clear Button Style -->
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#4B1D24"/>
            <Setter Property="Background" Value="#1A0D11"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D1217"/>
                    <Setter Property="Foreground" Value="#FCA5A5"/>
                    <Setter Property="BorderBrush" Value="#7F1D1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Outline / Play Button Style -->
        <Style TargetType="Button" x:Key="PrimaryOutlineButton" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
            <Setter Property="BorderBrush" Value="#8B5CF6"/>
            <Setter Property="Background" Value="#18132B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D1D54"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#A78BFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Chip RadioButton Style -->
        <Style TargetType="RadioButton" x:Key="FilterChipStyle">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style TargetType="Slider" x:Key="ModernSliderStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#27272A" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource PrimaryBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Volume Slider Style -->
        <Style TargetType="Slider" x:Key="VolumeSliderStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#27272A" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource PrimaryBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.6"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Video Player Timeline Scrubber Slider Style -->
        <Style TargetType="Slider" x:Key="TimelineSliderStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24" Background="Transparent">
                            <!-- Background Track Bar -->
                            <Border Height="6" Background="#27272A" CornerRadius="3" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#0284C7" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF" Stroke="#38BDF8" StrokeThickness="2.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#38BDF8" Opacity="0.6"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,2,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                            <Border x:Name="TrackBorder" Background="Transparent" CornerRadius="5" Width="8" HorizontalAlignment="Right" Margin="0"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Width="8" HorizontalAlignment="Right" Margin="0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="{StaticResource ScrollBarThumbIdleBrush}" CornerRadius="4" BorderThickness="0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbDraggingBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Trimming Slider Thumb -->
        <Style TargetType="Thumb" x:Key="ModernThumbStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Width="16" Height="16" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="InnerEllipse" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="InnerEllipse" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerEllipse" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Background" Value="#111115"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Trim/Time TextBox: Start/End (No Watermarks, just text) -->
        <Style x:Key="TrimTimeTextBox" BasedOn="{StaticResource ModernTextBox}" TargetType="TextBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Background" Value="#111115"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crop Thumb Styles -->
        <Style x:Key="CropEdgeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#38BDF8" BorderBrush="White" BorderThickness="1" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropCornerThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White" BorderBrush="#38BDF8" BorderThickness="2" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CropCenterThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="#01FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="ModernCheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="CheckBoxBorder" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 4 10 L 8 14 L 16 6" Stroke="White" StrokeThickness="2" Stretch="None" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="AnimeCheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" 
                                Width="20" 
                                Height="20" 
                                CornerRadius="6" 
                                BorderThickness="1.5" 
                                BorderBrush="#3A3A4C" 
                                Background="#1A1A26" 
                                VerticalAlignment="Center">
                            <Path x:Name="CheckIcon" 
                                  Data="M 4 10 L 8 14 L 16 6" 
                                  Stroke="White" 
                                  StrokeThickness="2.2" 
                                  StrokeStartLineCap="Round" 
                                  StrokeEndLineCap="Round" 
                                  StrokeLineJoin="Round"
                                  Stretch="None" 
                                  Visibility="Collapsed" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#F43F5E"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#F43F5E"/>
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FB7185"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- The ToggleButton stretches across the ENTIRE ComboBox area -->
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" 
                                          Cursor="Hand"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder" 
                                                Background="{StaticResource SurfaceBrush}" 
                                                BorderBrush="{StaticResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="12">
                                            <Grid Margin="16,10,14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Arrow / Chevron -->
                                                <Path x:Name="Arrow" 
                                                      Grid.Column="1"
                                                      Data="M7,10L12,15L17,10" 
                                                      Stroke="{StaticResource TextSecondaryBrush}" 
                                                      StrokeThickness="2" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Stretch="None"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="Arrow" Property="Data" Value="M7,15L12,10L17,15"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Content Presenter on top with IsHitTestVisible="False" so entire box clicks through to ToggleButton -->
                            <Grid Margin="16,0,40,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                <ContentPresenter x:Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="13.5"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>

                            <!-- Dropdown Popup -->
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide" 
                                   StaysOpen="False">
                                <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Margin="0,4,0,4"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Color="Black" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox Style based on ModernComboBox -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>

        <!-- ComboBox Item Style with proper hover and selected states -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A8B5CF6"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar" x:Key="ModernProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#EC4899" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowControlButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="buttonBorder">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="WindowCloseButton" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Name="buttonBorder">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainWindowRootBorder"
            Background="{StaticResource BackgroundBrush}"
            CornerRadius="16"
            Effect="{StaticResource WindowShadow}"
            ClipToBounds="True"
            BorderThickness="1" 
            BorderBrush="{StaticResource BorderBrush}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="Transparent" 
                    Height="50" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="Universal Downloader" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Update Available Notification Button (Visible when update exists) -->
                        <Button x:Name="UpdateAvailableButton" 
                                Style="{StaticResource ModernButton}" 
                                Height="30" 
                                Margin="0,10,12,0" 
                                Padding="12,0" 
                                FontSize="11.5" 
                                Background="#059669" 
                                BorderBrush="#10B981" 
                                Visibility="Collapsed" 
                                Click="UpdateAvailableButton_Click" 
                                ToolTip="New version available! Click to view update details.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✨ Update" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UpdateBadgeTextBlock" Text=" v1.0.9" FontSize="10.5" FontWeight="SemiBold" Foreground="#D1FAE5" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Content="&#xE713;" Style="{StaticResource WindowControlButton}" Click="SettingsButton_Click" ToolTip="Settings"/>
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowControlButton}" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaximizeRestoreButton" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize"/>
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <!-- Main Downloader View -->
                <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                    <StackPanel Margin="32,20,76,40" MaxWidth="680">
                        
                        <!-- Header -->
                        <TextBlock Text="Download Everything." 
                                   FontSize="42" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   TextAlignment="Center" 
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Paste a URL from YouTube, Drive, Spotify, or any direct file." 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="16" 
                                   TextAlignment="Center" 
                                   Margin="0,0,0,50"/>

                        <!-- URL Input Container -->
                        <Border Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" 
                                Padding="24" 
                                Margin="0,0,0,32" 
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LINK TO DOWNLOAD" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📋 Batch Import" Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="11.5" Click="BatchImportButton_Click" ToolTip="Paste multiple URLs at once"/>
                                </Grid>
                                <TextBox x:Name="UrlTextBox" Style="{StaticResource ModernTextBox}" Text="Paste URL here..." TextChanged="UrlTextBox_TextChanged" GotFocus="UrlTextBox_GotFocus" LostFocus="UrlTextBox_LostFocus" PreviewMouseDown="UrlTextBox_PreviewMouseDown"/>
                            </StackPanel>
                        </Border>

                        <!-- Settings Container -->
                        <StackPanel Margin="0,0,0,32" VerticalAlignment="Stretch">

                            <!-- Download Location -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="SAVE LOCATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DirectoryPathTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Select folder..." Margin="0,0,16,0"/>
                                        <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="BrowseButton_Click" Padding="24,12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Quality Selection -->
                            <Border x:Name="QualitySection" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Visibility="Collapsed" Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="VIDEO QUALITY" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="VideoTitleInfoBlock" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ComboBox x:Name="YouTubeQualityComboBox" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Label" SelectedValuePath="FormatCode" SelectionChanged="YouTubeQualityComboBox_SelectionChanged" PreviewMouseLeftButtonDown="YouTubeQualityComboBox_PreviewMouseLeftButtonDown"/>
                                </StackPanel>
                            </Border>

                            <!-- Playlist Section (only visible for playlist URLs) -->
                            <Border x:Name="PlaylistSection" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Visibility="Collapsed" Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- Header row -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PLAYLIST" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PlaylistTitleLabel" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,12,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="PlaylistCountLabel" Grid.Column="2" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Quick buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Button Content="Select All" Style="{StaticResource SecondaryButton}" Click="PlaylistSelectAll_Click" Padding="14,6" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Content="Deselect All" Style="{StaticResource SecondaryButton}" Click="PlaylistDeselectAll_Click" Padding="14,6" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Scrollable item list -->
                                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="PlaylistItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0DFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Checkbox -->
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0" Padding="0"/>

                                                            <!-- Title -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                                            <!-- Duration -->
                                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="50" TextAlignment="Right"/>

                                                            <!-- Quality selector -->
                                                            <ComboBox Grid.Column="3" 
                                                                      ItemsSource="{Binding AvailableQualities}" 
                                                                      SelectedIndex="{Binding SelectedQualityIndex, Mode=TwoWay}" 
                                                                      DisplayMemberPath="Label"
                                                                      Style="{StaticResource ModernComboBox}" 
                                                                      Width="150" 
                                                                      Padding="8,6"
                                                                      FontSize="12"
                                                                      MaxDropDownHeight="200"
                                                                      VerticalAlignment="Center"
                                                                      PreviewMouseLeftButtonDown="YouTubeQualityComboBox_PreviewMouseLeftButtonDown"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Trimming Section -->
                            <Border x:Name="TrimmingSection" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Visibility="Collapsed" Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TRIMMING" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="VideoDurationLabel" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <CheckBox x:Name="EnableTrimmingCheckBox" Content="Enable trim" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,20" IsChecked="False" Checked="EnableTrimmingCheckBox_CheckedChanged" Unchecked="EnableTrimmingCheckBox_CheckedChanged"/>
                                    
                                    <StackPanel x:Name="TrimControlsPanel" Visibility="Collapsed">
                                        <!-- Slider with padding -->
                                        <Canvas x:Name="SliderCanvas" Height="30" Margin="8,0,8,16" SizeChanged="SliderCanvas_SizeChanged" MouseLeftButtonDown="SliderCanvas_MouseLeftButtonDown">
                                            <!-- Track Background -->
                                            <Rectangle x:Name="SliderTrack" Height="6" Fill="{StaticResource BorderBrush}" Canvas.Top="12" RadiusX="3" RadiusY="3" IsHitTestVisible="False"/>
                                            
                                            <!-- Active Range Fill -->
                                            <Rectangle x:Name="SliderFill" Height="6" Fill="{StaticResource PrimaryGradient}" Canvas.Top="12" RadiusX="3" RadiusY="3" IsHitTestVisible="False"/>
                                            
                                            <!-- Start Thumb -->
                                            <Thumb x:Name="StartThumb" Width="18" Height="18" Canvas.Top="6" Style="{StaticResource ModernThumbStyle}" DragDelta="StartThumb_DragDelta" Margin="-9,0,0,0"/>

                                            <!-- End Thumb -->
                                            <Thumb x:Name="EndThumb" Width="18" Height="18" Canvas.Top="6" Style="{StaticResource ModernThumbStyle}" DragDelta="EndThumb_DragDelta" Margin="-9,0,0,0"/>
                                        </Canvas>
                                        
                                        <!-- Time inputs with labels -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Start time -->
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                                <TextBlock Text="START" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                <TextBox x:Name="StartTimeTextBox" Style="{StaticResource TrimTimeTextBox}" Width="110" Height="44" TextChanged="TimeTextBox_TextChanged" LostFocus="TimeTextBox_LostFocus" KeyDown="TimeTextBox_KeyDown"/>
                                            </StackPanel>
                                            
                                            <!-- End time -->
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="END" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                                <TextBox x:Name="EndTimeTextBox" Style="{StaticResource TrimTimeTextBox}" Width="110" Height="44" TextChanged="TimeTextBox_TextChanged" LostFocus="TimeTextBox_LostFocus" KeyDown="TimeTextBox_KeyDown"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Download Trigger -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DownloadButton" Grid.Column="0" Style="{StaticResource ModernButton}" Content="Start Download" Click="DownloadButton_Click" IsEnabled="False" Width="180" Height="46" Margin="0,0,10,0"/>
                            <Button x:Name="AddToQueueButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="➕ Add to Queue" Click="AddToQueueButton_Click" IsEnabled="False" Width="150" Height="46"/>
                            <Button x:Name="CancelDownloadButton" Grid.Column="2" Style="{StaticResource MinimalistCancelButton}" Click="CancelDownloadButton_Click" Visibility="Collapsed" Margin="10,0,0,0" Height="46" Width="46"/>
                        </Grid>

                        <!-- Status Display -->
                        <Border x:Name="StatusPanel"
                                Background="{StaticResource GlassGradient}" 
                                CornerRadius="16" 
                                Padding="28,24"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <!-- File name / title -->
                                <TextBlock x:Name="FileNameTextBlock" 
                                           Text="" 
                                           FontWeight="SemiBold" 
                                           FontSize="15" 
                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,14"
                                           Visibility="Collapsed"/>
                                           
                                <!-- Progress bar -->
                                <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource ModernProgressBar}" Margin="0,0,0,12"/>

                                <!-- Status message -->
                                <TextBlock x:Name="StatusTextBlock" 
                                           Text="Ready to download. Paste a URL above." 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           TextAlignment="Center" 
                                           TextWrapping="Wrap"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Settings View -->
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="40,20,40,40" MaxWidth="680">
                        
                        <!-- Back Button -->
                        <Button Content="&#x2190; Back to Downloader" Style="{StaticResource SecondaryButton}" Click="BackToDownloader_Click" Margin="0,0,0,24" HorizontalAlignment="Left" Padding="14,8"/>

                        <!-- Header -->
                        <TextBlock Text="Settings" 
                                   FontSize="36" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="0,0,0,32"/>
                        <StackPanel>
                            <!-- General Settings -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="GENERAL PREFERENCES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    
                                    <!-- Auto Detect Clipboard CheckBox -->
                                    <CheckBox x:Name="AutoDetectClipboardCheckBox" Style="{StaticResource ModernCheckBox}" Content="Auto-detect media links from clipboard" Margin="0,0,0,12" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>
                                    
                                    <!-- Embed Metadata CheckBox -->
                                    <CheckBox x:Name="EmbedMetadataCheckBox" Style="{StaticResource ModernCheckBox}" Content="Embed metadata / tags into media files (YouTube, Spotify)" Margin="0,0,0,12" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>
                                    
                                    <!-- Download Subtitles CheckBox -->
                                    <CheckBox x:Name="DownloadSubtitlesCheckBox" Style="{StaticResource ModernCheckBox}" Content="Auto-download subtitles when available" Margin="0,0,0,12" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>
                                    
                                    <!-- Multi-Connection Acceleration CheckBox -->
                                    <CheckBox x:Name="MultiConnectionAccelerationCheckBox" Style="{StaticResource ModernCheckBox}" Content="Enable multi-connection download acceleration (aria2c)" Margin="0,0,0,12" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>

                                    <!-- Download Synced Lyrics (.lrc) CheckBox -->
                                    <CheckBox x:Name="DownloadLyricsCheckBox" Style="{StaticResource ModernCheckBox}" Content="Auto-download synchronized lyrics (.lrc companion file) for audio tracks" Margin="0,0,0,12" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>

                                    <!-- Minimize to Tray CheckBox -->
                                    <CheckBox x:Name="MinimizeToTrayCheckBox" Style="{StaticResource ModernCheckBox}" Content="Minimize to system tray on close" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Default Save Location -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="DEFAULT SAVE LOCATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsDirectoryPathTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Select folder..." Margin="0,0,16,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Browse" Click="BrowseButton_Click" Padding="24,12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Custom Filename Template -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM FILENAME TEMPLATE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Customize how downloaded files are named using placeholders:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
                                    
                                    <!-- Template Input Field -->
                                    <TextBox x:Name="FilenameTemplateTextBox" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Text="%(title)s.%(ext)s" 
                                             TextChanged="FilenameTemplateTextBox_TextChanged"
                                             Margin="0,0,0,12"/>

                                    <!-- Available Variable Chips -->
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="%(title)s" Style="{StaticResource SecondaryButton}" Tag="%(title)s" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert video/track title"/>
                                        <Button Content="%(uploader)s" Style="{StaticResource SecondaryButton}" Tag="%(uploader)s" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert channel or artist name"/>
                                        <Button Content="%(resolution)s" Style="{StaticResource SecondaryButton}" Tag="%(resolution)s" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert resolution (e.g. 1080p)"/>
                                        <Button Content="%(upload_date)s" Style="{StaticResource SecondaryButton}" Tag="%(upload_date)s" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert upload date (YYYYMMDD)"/>
                                        <Button Content="%(id)s" Style="{StaticResource SecondaryButton}" Tag="%(id)s" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert media ID"/>
                                        <Button Content="{}{platform}" Style="{StaticResource SecondaryButton}" Tag="{}{platform}" Click="TemplateChip_Click" Padding="8,4" FontSize="11" Margin="0,0,6,6" ToolTip="Insert platform name (YouTube, Spotify, etc.)"/>
                                    </WrapPanel>

                                    <!-- Live Preview -->
                                    <Border Background="#121214" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Preview:  " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="FilenameTemplatePreview" Grid.Column="1" Text="Never Gonna Give You Up.mp4" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Hotkeys Section -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="HOTKEYS &amp; SHORTCUTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Live Stream / DJ Scraper Toggle" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Hotkey to start and stop continuous PC Audio recognition" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LiveStreamHotkeyComboBox" 
                                                  Grid.Column="1" 
                                                  Style="{StaticResource ModernComboBox}"
                                                  Width="150" 
                                                  Height="36" 
                                                  SelectionChanged="LiveStreamHotkeyComboBox_SelectionChanged">
                                            <ComboBoxItem Content="F9 (Default)" Tag="F9" IsSelected="True"/>
                                            <ComboBoxItem Content="F8" Tag="F8"/>
                                            <ComboBoxItem Content="F10" Tag="F10"/>
                                            <ComboBoxItem Content="F11" Tag="F11"/>
                                            <ComboBoxItem Content="F12" Tag="F12"/>
                                            <ComboBoxItem Content="Ctrl + Shift + S" Tag="Ctrl+Shift+S"/>
                                            <ComboBoxItem Content="Ctrl + Shift + L" Tag="Ctrl+Shift+L"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Dependencies Section -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="DEPENDENCIES &amp; TOOLS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="yt-dlp core engine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsYtDlpStatus" Text="Ready (Latest)" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Update Engine" Click="UpdateYtDlp_Click" Padding="14,6" FontSize="11"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="FFmpeg &amp; FFprobe" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SettingsFfmpegStatus" Text="Ready (Offline)" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- App Updates Section -->
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="APPLICATION UPDATES" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>
                                    
                                    <!-- Auto Check Updates CheckBox -->
                                    <CheckBox x:Name="AutoCheckUpdatesCheckBox" Style="{StaticResource ModernCheckBox}" Content="Check for updates automatically on startup" Margin="0,0,0,16" IsChecked="True" Checked="SettingCheckbox_Changed" Unchecked="SettingCheckbox_Changed"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Universal Downloader" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SettingsAppVersionText" Text=" (v1.0.15)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="SettingsUpdateStatusText" Text="Check for newer releases on GitHub" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="🔄 Check for Updates" Click="CheckForUpdates_Click" Padding="14,6" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- History View -->
                <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,20,76,90" MaxWidth="780">
                        <!-- Top Bar: Back & Clear History -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="&#x2190; Back to Downloader" Style="{StaticResource SecondaryButton}" Click="BackFromHistory_Click" HorizontalAlignment="Left" Padding="14,8"/>
                            <Button Grid.Column="1" Content="🗑 Clear All History" Style="{StaticResource DangerButton}" Click="ClearAllHistory_Click" Padding="14,8" FontSize="12" ToolTip="Delete all items from download history"/>
                        </Grid>

                        <!-- Header & Count -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Download History" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="HistoryMatchCountTextBlock" 
                                       Grid.Column="1" 
                                       Text="0 items" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="13" 
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Search Box -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="42" Padding="12,0" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBox x:Name="HistorySearchTextBox" Grid.Column="1" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" TextChanged="HistorySearchTextBox_TextChanged" CaretBrush="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Search history by title, URL, or platform..." IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="HistoryClearSearchButton" Grid.Column="2" Content="✕" Width="24" Height="24" FontSize="11" Click="HistoryClearSearchButton_Click" ToolTip="Clear search">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MinimalistCancelButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Category Filter Chips -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FilterChipAll" Content="All" GroupName="HistoryFilterGroup" IsChecked="True" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="All" Margin="0,0,8,0"/>
                                <RadioButton Content="YouTube" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="YouTube" Margin="0,0,8,0"/>
                                <RadioButton Content="Spotify" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="Spotify" Margin="0,0,8,0"/>
                                <RadioButton Content="TikTok" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="TikTok" Margin="0,0,8,0"/>
                                <RadioButton Content="Instagram" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="Instagram" Margin="0,0,8,0"/>
                                <RadioButton Content="🎵 Audio" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="Audio" Margin="0,0,8,0"/>
                                <RadioButton Content="🎬 Video" GroupName="HistoryFilterGroup" Style="{StaticResource FilterChipStyle}" Click="HistoryFilterChip_Click" Tag="Video" Margin="0,0,8,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty Search / Filter State -->
                        <Border x:Name="HistoryEmptyStatePanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No downloads found" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Try adjusting your search query or filter chips." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <Button Content="Reset Filters" Style="{StaticResource SecondaryButton}" Click="HistoryResetFilters_Click" HorizontalAlignment="Center" Padding="14,6"/>
                            </StackPanel>
                        </Border>

                        <!-- History Items List -->
                        <ItemsControl x:Name="HistoryItemsControl" ItemsSource="{Binding Path=FilteredHistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Effect="{StaticResource CardShadow}" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Item Info -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="15" 
                                                           FontWeight="SemiBold" 
                                                           TextTrimming="CharacterEllipsis" 
                                                           Margin="0,0,0,4"
                                                           Cursor="Hand"
                                                           ToolTip="Click to copy title"
                                                           MouseLeftButtonUp="HistoryItemTitle_MouseLeftButtonUp">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#208B5CF6" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Platform}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="•" Foreground="{StaticResource BorderBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DownloadDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryOutlineButton}" Content="▶ Play" Click="HistoryPreviewPlay_Click" Tag="{Binding}" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Preview in media player"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🎞️ Clip" Click="HistoryCreateClip_Click" Tag="{Binding}" Margin="0,0,8,0" Padding="10,6" FontSize="12" ToolTip="Create GIF or WebP clip from this video"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="📂 Folder" Click="HistoryOpenFolder_Click" Tag="{Binding}" Margin="0,0,8,0" Padding="10,6" FontSize="12" ToolTip="Show file in folder"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="🔗 Link" Click="HistoryCopyUrl_Click" Tag="{Binding}" Margin="0,0,8,0" Padding="10,6" FontSize="12" ToolTip="Open source link in browser and copy URL"/>
                                                <Button Style="{StaticResource MinimalistCancelButton}" Content="✕" Click="HistoryDeleteItem_Click" Tag="{Binding}" Padding="8,6" FontSize="11" ToolTip="Remove from history"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Media Converter View -->
                <ScrollViewer x:Name="ConverterScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" 
                              Visibility="Collapsed"
                              AllowDrop="True"
                              Drop="ConverterDropZone_Drop"
                              DragOver="ConverterDropZone_DragOver"
                              PreviewDragOver="ConverterDropZone_PreviewDragOver"
                              PreviewDrop="ConverterDropZone_PreviewDrop">
                    <StackPanel Margin="40,20,40,90" MaxWidth="760">
                        <!-- Top Bar: Back Button -->
                        <Grid Margin="0,0,0,20">
                            <Button Content="&#x2190; Back to Downloader" Style="{StaticResource SecondaryButton}" Click="BackFromConverter_Click" HorizontalAlignment="Left" Padding="14,8"/>
                        </Grid>

                        <!-- Header -->
                        <TextBlock Text="Media Converter" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Convert your local audio and video files with ultra-fast offline FFmpeg encoding." 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="13" 
                                   Margin="0,0,0,20"/>

                        <!-- Drag & Drop Zone / Browse -->
                        <Border x:Name="ConverterDropZone" 
                                Background="#141418" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="2" 
                                CornerRadius="16" 
                                Padding="32,24" 
                                Margin="0,0,0,20"
                                AllowDrop="True"
                                Drop="ConverterDropZone_Drop"
                                DragOver="ConverterDropZone_DragOver"
                                PreviewDragOver="ConverterDropZone_PreviewDragOver"
                                PreviewDragEnter="ConverterDropZone_PreviewDragEnter"
                                PreviewDragLeave="ConverterDropZone_PreviewDragLeave"
                                PreviewDrop="ConverterDropZone_PreviewDrop"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="ConverterBrowseFiles_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Drag &amp; Drop audio/video files or folders here" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="or click to browse local files (MP4, MKV, MP3, FLAC, WAV, M4A, AVI, WEBM, etc.)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button Content="Browse Files" Style="{StaticResource SecondaryButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Center" Click="ConverterBrowseFiles_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected Files List -->
                        <Border x:Name="ConverterFilesListBorder" 
                                Background="{StaticResource SurfaceBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,0,0,20" 
                                Visibility="Collapsed"
                                AllowDrop="True"
                                Drop="ConverterDropZone_Drop"
                                DragOver="ConverterDropZone_DragOver"
                                PreviewDragOver="ConverterDropZone_PreviewDragOver"
                                PreviewDrop="ConverterDropZone_PreviewDrop">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="FILES TO CONVERT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Clear List" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11" Click="ConverterClearAll_Click"/>
                                </Grid>

                                <ItemsControl x:Name="ConverterItemsControl" ItemsSource="{Binding Path=ConverterItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- File Info & Progress -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                            <TextBlock Text="{Binding FileSize}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,8,0"/>
                                                            <TextBlock Text="•" Foreground="{StaticResource BorderBrush}" FontSize="11" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="11.5"/>
                                                        </StackPanel>
                                                        <!-- Item Progress Bar when active -->
                                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Background="#27272A" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>

                                                    <!-- Item Action Buttons -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Play preview if completed -->
                                                        <Button Content="▶ Play" Click="ConverterPlayItem_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="10,5" FontSize="11">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryOutlineButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <!-- Folder button if completed -->
                                                        <Button Content="📂 Folder" Click="ConverterOpenItemFolder_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="8,5" FontSize="11">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <!-- Remove item -->
                                                        <Button Content="✕" Style="{StaticResource MinimalistCancelButton}" Click="ConverterRemoveItem_Click" Tag="{Binding}" Width="26" Height="26" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Conversion Settings Card -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="CONVERSION SETTINGS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Target Format -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Target Format:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ConverterTargetFormatComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="MP3 Audio (.mp3)" IsSelected="True"/>
                                            <ComboBoxItem Content="M4A / AAC Audio (.m4a)"/>
                                            <ComboBoxItem Content="FLAC Lossless (.flac)"/>
                                            <ComboBoxItem Content="WAV Lossless (.wav)"/>
                                            <ComboBoxItem Content="OGG Vorbis (.ogg)"/>
                                            <ComboBoxItem Content="OPUS Audio (.opus)"/>
                                            <ComboBoxItem Content="MP4 Video (.mp4)"/>
                                            <ComboBoxItem Content="MKV Video (.mkv)"/>
                                            <ComboBoxItem Content="WEBM Video (.webm)"/>
                                            <ComboBoxItem Content="AVI Video (.avi)"/>
                                            <ComboBoxItem Content="GIF Animation (.gif)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Audio Bitrate -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Audio Bitrate / Quality:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ConverterAudioBitrateComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="320 kbps (High Quality)" IsSelected="True"/>
                                            <ComboBoxItem Content="256 kbps"/>
                                            <ComboBoxItem Content="192 kbps (Standard)"/>
                                            <ComboBoxItem Content="128 kbps (Compact)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Video Scale Preset -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Video Resolution (if converting video):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ConverterVideoResolutionComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                            <ComboBoxItem Content="Original Resolution" IsSelected="True"/>
                                            <ComboBoxItem Content="1080p Full HD"/>
                                            <ComboBoxItem Content="720p HD"/>
                                            <ComboBoxItem Content="480p SD"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Output Folder -->
                                <TextBlock Text="Output Destination:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ConverterDestinationTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Select output folder..." Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Padding="20,10" Click="ConverterBrowseDestination_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Start Conversion Button & Action Bar -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,14" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ConverterAutoPowerCheckBox" 
                                              Style="{StaticResource ModernCheckBox}" 
                                              Content="⏻ When finished:" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,10,0"
                                              ToolTip="Automatically trigger selected power action when media conversion completes"/>
                                    <ComboBox x:Name="ConverterAutoPowerActionComboBox" 
                                              Style="{StaticResource ModernComboBox}" 
                                              Width="125" 
                                              Height="36" 
                                              Padding="12,6" 
                                              FontSize="12" 
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Shut down"/>
                                        <ComboBoxItem Content="Sleep"/>
                                        <ComboBoxItem Content="Hibernate"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="StartConversionButton" 
                                        Grid.Column="1"
                                        Content="⚡ Start Conversion" 
                                        Style="{StaticResource ModernButton}" 
                                        Height="44" 
                                        Width="200" 
                                        Click="StartConversionButton_Click"
                                        IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Smart Video Compressor View -->
                <ScrollViewer x:Name="CompressorScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" 
                              Visibility="Collapsed"
                              AllowDrop="True"
                              Drop="CompressorDropZone_Drop"
                              DragOver="CompressorDropZone_DragOver"
                              PreviewDragOver="CompressorDropZone_PreviewDragOver"
                              PreviewDrop="CompressorDropZone_PreviewDrop">
                    <StackPanel Margin="40,20,40,90" MaxWidth="760">
                        <!-- Top Bar: Back Button -->
                        <Grid Margin="0,0,0,20">
                            <Button Content="&#x2190; Back to Downloader" Style="{StaticResource SecondaryButton}" Click="BackFromCompressor_Click" HorizontalAlignment="Left" Padding="14,8"/>
                        </Grid>

                        <!-- Header -->
                        <TextBlock Text="Smart Video Compressor" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Compress videos with visually lossless quality by default, or customize target file sizes, codecs, and resolution." 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="13" 
                                   Margin="0,0,0,20"/>

                        <!-- Drag & Drop Zone / Browse -->
                        <Border x:Name="CompressorDropZone" 
                                Background="#141418" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="2" 
                                CornerRadius="16" 
                                Padding="32,24" 
                                Margin="0,0,0,20"
                                AllowDrop="True"
                                Drop="CompressorDropZone_Drop"
                                DragOver="CompressorDropZone_DragOver"
                                PreviewDragOver="CompressorDropZone_PreviewDragOver"
                                PreviewDragEnter="CompressorDropZone_PreviewDragEnter"
                                PreviewDragLeave="CompressorDropZone_PreviewDragLeave"
                                PreviewDrop="CompressorDropZone_PreviewDrop"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="CompressorBrowseFiles_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗜️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Drag &amp; Drop video files or folders here to compress" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="or click to browse local files (MP4, MKV, MOV, WEBM, AVI, FLV, TS, WMV)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <Button Content="Browse Videos" Style="{StaticResource SecondaryButton}" Padding="16,6" FontSize="12" HorizontalAlignment="Center" Click="CompressorBrowseFiles_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected Files List -->
                        <Border x:Name="CompressorFilesListBorder" 
                                Background="{StaticResource SurfaceBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,0,0,20" 
                                Visibility="Collapsed"
                                AllowDrop="True"
                                Drop="CompressorDropZone_Drop"
                                DragOver="CompressorDropZone_DragOver"
                                PreviewDragOver="CompressorDropZone_PreviewDragOver"
                                PreviewDrop="CompressorDropZone_PreviewDrop">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="VIDEOS TO COMPRESS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CompressorTotalEtaTextBlock" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Clear List" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11" Click="CompressorClearAll_Click"/>
                                </Grid>

                                <ItemsControl x:Name="CompressorItemsControl" ItemsSource="{Binding Path=CompressorItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Video Info & Size Comparison -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                            <TextBlock Text="{Binding OriginalSizeFormatted}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"/>
                                                            <TextBlock Text=" ➔ " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding CompressedSizeFormatted}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text=" (" Foreground="#10B981" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding SavingsFormatted}" Foreground="#10B981" FontWeight="Bold" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text=")" Foreground="#10B981" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource BorderBrush}" FontSize="11" Margin="6,0,6,0"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="11.5"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource BorderBrush}" FontSize="11" Margin="6,0,6,0" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding DurationFormatted}" Foreground="#A1A1AA" FontSize="11.5" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text=" • " Foreground="{StaticResource BorderBrush}" FontSize="11" Margin="6,0,6,0" Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding TimeRemainingFormatted}" Foreground="#38BDF8" FontSize="11.5" Visibility="{Binding IsCompressing, Converter={StaticResource BoolToVisConverter}}"/>
                                                        </StackPanel>

                                                        <!-- Progress Bar -->
                                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Background="#27272A" Foreground="#06B6D4" BorderThickness="0" Margin="0,2,0,0">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompressing}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▶ Play" Click="CompressorPlayItem_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="10,5" FontSize="11">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryOutlineButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="📂 Folder" Click="CompressorOpenItemFolder_Click" Tag="{Binding}" Margin="0,0,6,0" Padding="8,5" FontSize="11">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="✕" Style="{StaticResource MinimalistCancelButton}" Click="CompressorRemoveItem_Click" Tag="{Binding}" Width="26" Height="26" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Compression Settings Card -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="COMPRESSION SETTINGS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                                <!-- Mode / Preset Selection -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Compression Mode:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CompressorPresetComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="CompressorPresetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="✨ Visually Lossless (Recommended - Zero Noticeable Quality Loss)" IsSelected="True"/>
                                        <ComboBoxItem Content="⚖️ Balanced (Optimized for Web &amp; Discord Sharing)"/>
                                        <ComboBoxItem Content="🗜️ Maximum Compression (Smallest File Size)"/>
                                        <ComboBoxItem Content="🎯 Target File Size (e.g. Discord 25MB Limit)"/>
                                        <ComboBoxItem Content="⚙️ Custom Parameters"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Hardware Device (GPU vs CPU) -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Encoding Device:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CompressorDeviceComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="⚡ Hardware GPU (NVIDIA NVENC / AMD AMF / Intel QSV / Apple VideoToolbox - Recommended)" IsSelected="True"/>
                                        <ComboBoxItem Content="💻 Software CPU (Universal Compatibility, Slower)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Drop-Down Menu for Detailed Parameters & Output Destination -->
                                <Border x:Name="CompressorDropdownBorder"
                                        Background="#141416"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Dropdown Header Button -->
                                        <Button x:Name="CompressorToggleSettingsButton"
                                                Click="CompressorToggleSettings_Click"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="16,12">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="10" 
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1F1F23"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Advanced Parameters &amp; Destination" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                                               FontSize="13" 
                                                               FontWeight="SemiBold" 
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text=" (CRF, Codec, FPS, Audio, Speed, Folder)" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                                               FontSize="11.5" 
                                                               VerticalAlignment="Center" 
                                                               Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="CompressorDropdownArrow" 
                                                           Grid.Column="1" 
                                                           Text="▼" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center" 
                                                           Margin="8,0,4,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- Collapsible Dropdown Content -->
                                        <Border x:Name="CompressorDetailedSettingsPanel" 
                                                Visibility="Collapsed" 
                                                Padding="16,14,16,16" 
                                                BorderBrush="{StaticResource BorderBrush}" 
                                                BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <!-- Target Size Quick Selector (when Target Size mode is selected) -->
                                                <Border x:Name="CompressorTargetSizePanel" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="Target File Size Limit (MB):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="140"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox x:Name="CompressorTargetSizeTextBox" Grid.Column="0" Text="25" Style="{StaticResource ModernTextBox}" Height="36" Padding="8,4" FontSize="13" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Column="1" Text="MB per video" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                        </Grid>
                                                        <WrapPanel Orientation="Horizontal">
                                                            <TextBlock Text="Quick presets:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <Button Content="Discord 25 MB" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,4" Tag="25" Click="TargetSizePresetButton_Click"/>
                                                            <Button Content="Discord 50 MB" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,4" Tag="50" Click="TargetSizePresetButton_Click"/>
                                                            <Button Content="Discord Nitro 100 MB" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,4" Tag="100" Click="TargetSizePresetButton_Click"/>
                                                            <Button Content="Email 10 MB" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,4" Tag="10" Click="TargetSizePresetButton_Click"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- CRF / Quality Slider (visible for Lossless, Balanced, MaxCompression, Custom) -->
                                                <Border x:Name="CompressorCrfPanel" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Quality Factor (CRF):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                            <TextBlock Grid.Column="1" x:Name="CompressorCrfValueTextBlock" Text="20 (Visually Lossless - Recommended)" Foreground="#06B6D4" FontWeight="SemiBold" FontSize="12"/>
                                                        </Grid>
                                                        <Slider x:Name="CompressorCrfSlider" Minimum="16" Maximum="36" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="CompressorCrfSlider_ValueChanged" Margin="0,4,0,6"/>
                                                        <TextBlock Text="Lower CRF preserves master visual fidelity. Values 18–21 provide zero noticeable loss with 40%–70% size reduction." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Codec and Resolution Grid -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Video Codec -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="Video Codec:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CompressorCodecComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                            <ComboBoxItem Content="H.264 / AVC (Universal Compatibility)" IsSelected="True"/>
                                                            <ComboBoxItem Content="H.265 / HEVC (High Efficiency - Smaller)"/>
                                                            <ComboBoxItem Content="AV1 (Next-Gen Ultra Compression)"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Resolution Downscaling -->
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Resolution Limit:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CompressorResolutionComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                            <ComboBoxItem Content="Original Resolution" Tag="Original" IsSelected="True"/>
                                                            <ComboBoxItem Content="1080p Full HD" Tag="1080p"/>
                                                            <ComboBoxItem Content="720p HD" Tag="720p"/>
                                                            <ComboBoxItem Content="480p SD" Tag="480p"/>
                                                            <ComboBoxItem Content="360p Compact" Tag="360p"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- FPS and Audio Grid -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Frame Rate -->
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="Frame Rate (FPS):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CompressorFpsComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                            <ComboBoxItem Content="Original Framerate" Tag="Original" IsSelected="True"/>
                                                            <ComboBoxItem Content="Cap at 60 FPS" Tag="60"/>
                                                            <ComboBoxItem Content="Cap at 30 FPS" Tag="30"/>
                                                            <ComboBoxItem Content="Cap at 24 FPS" Tag="24"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- Audio Mode -->
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="Audio Handling:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CompressorAudioComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                            <ComboBoxItem Content="Passthrough Copy (Lossless Audio)" IsSelected="True"/>
                                                            <ComboBoxItem Content="AAC 128 kbps (Compact Web Audio)"/>
                                                            <ComboBoxItem Content="AAC 192 kbps (High Quality Audio)"/>
                                                            <ComboBoxItem Content="Opus 96 kbps (Ultra-efficient Audio)"/>
                                                            <ComboBoxItem Content="Mute (Strip Audio Track)"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Encoding Speed Preset -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <TextBlock Text="Encoding Speed / Preset:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CompressorPresetSpeedComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="1">
                                                            <ComboBoxItem Content="Medium (Balanced)" Tag="medium"/>
                                                            <ComboBoxItem Content="Slow (Better Compression - Recommended)" Tag="slow" IsSelected="True"/>
                                                            <ComboBoxItem Content="Fast (Faster Encoding)" Tag="fast"/>
                                                            <ComboBoxItem Content="Very Slow (Max Compression)" Tag="veryslow"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Output Folder Destination -->
                                                <StackPanel Margin="0,0,0,4">
                                                    <CheckBox x:Name="CompressorAutoSubfolderCheckBox" 
                                                              Content="📁 Save into 'Compressed' subfolder in source directory (Default)" 
                                                              IsChecked="True" 
                                                              Foreground="{StaticResource TextPrimaryBrush}" 
                                                              FontSize="12.5" 
                                                              FontWeight="SemiBold" 
                                                              Click="CompressorAutoSubfolderCheckBox_Click"
                                                              Margin="0,0,0,8"/>
                                                    <TextBlock Text="Output Destination:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="CompressorDestinationTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Text="Automatic: [Source Directory]\Compressed" Margin="0,0,8,0"/>
                                                        <Button Grid.Column="1" Content="Browse Custom..." Style="{StaticResource SecondaryButton}" Padding="14,10" Click="CompressorBrowseDestination_Click" Margin="0,0,8,0"/>
                                                        <Button x:Name="CompressorResetDestinationButton" Grid.Column="2" Content="Reset" Style="{StaticResource SecondaryButton}" Padding="12,10" Click="CompressorResetDestination_Click" ToolTip="Reset to automatic source subfolder"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Start Compression Button & Action Bar -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,14" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CompressorAutoPowerCheckBox" 
                                              Style="{StaticResource ModernCheckBox}" 
                                              Content="⏻ When finished:" 
                                              VerticalAlignment="Center" 
                                              Margin="0,0,10,0"
                                              ToolTip="Automatically trigger selected power action when video compression completes"/>
                                    <ComboBox x:Name="CompressorAutoPowerActionComboBox" 
                                              Style="{StaticResource ModernComboBox}" 
                                              Width="125" 
                                              Height="36" 
                                              Padding="12,6" 
                                              FontSize="12" 
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Shut down"/>
                                        <ComboBoxItem Content="Sleep"/>
                                        <ComboBoxItem Content="Hibernate"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="StartCompressionButton" 
                                        Grid.Column="1"
                                        Content="🗜️ Start Video Compression" 
                                        Style="{StaticResource ModernButton}" 
                                        Height="44" 
                                        Width="240" 
                                        Click="StartCompressionButton_Click"
                                        IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- GIF & WebP Clip Creator Studio View -->
                <ScrollViewer x:Name="GifWebpScrollViewer" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" 
                              Visibility="Collapsed"
                              AllowDrop="True"
                              Drop="GifDropZone_Drop"
                              DragOver="GifDropZone_DragOver"
                              PreviewDragOver="GifDropZone_PreviewDragOver"
                              PreviewDrop="GifDropZone_PreviewDrop">
                    <StackPanel Margin="40,20,40,90" MaxWidth="780">
                        <!-- Top Bar: Back Button -->
                        <Grid Margin="0,0,0,20">
                            <Button Content="&#x2190; Back to Downloader" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="14,8" 
                                    FontSize="12.5" 
                                    Click="BackFromGifCreator_Click" 
                                    HorizontalAlignment="Left"/>
                        </Grid>

                        <!-- Header -->
                        <TextBlock Text="GIF &amp; WebP Clip Creator" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Trim and convert videos into high-fidelity animated GIFs and lightweight animated WebP stickers." 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="13" 
                                   Margin="0,0,0,20"/>

                        <!-- Drag & Drop Zone / Browse (Shown when no video loaded) -->
                        <Border x:Name="GifDropZone" 
                                Background="#141418" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="2" 
                                CornerRadius="16" 
                                Padding="32,28" 
                                Margin="0,0,0,20"
                                AllowDrop="True"
                                Drop="GifDropZone_Drop"
                                DragOver="GifDropZone_DragOver"
                                PreviewDragOver="GifDropZone_PreviewDragOver"
                                PreviewDragEnter="GifDropZone_PreviewDragEnter"
                                PreviewDragLeave="GifDropZone_PreviewDragLeave"
                                PreviewDrop="GifDropZone_PreviewDrop"
                                Cursor="Hand"
                                PreviewMouseLeftButtonDown="GifBrowseVideo_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎞️" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Drag &amp; Drop a video file here" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="or click to browse local video (MP4, MKV, MOV, WEBM, AVI, FLV, WMV)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <Button Content="Browse Video" Style="{StaticResource SecondaryButton}" Padding="18,7" FontSize="12.5" HorizontalAlignment="Center" Click="GifBrowseVideo_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Active Clip Creator Studio Container (Shown when a video is loaded) -->
                        <StackPanel x:Name="GifEditorContainer" Visibility="Collapsed">
                            
                            <!-- Source Video Info Card with Change Button -->
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="GifVideoTitleText" Text="Video Title.mp4" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="GifVideoMetaText" Text="1920x1080 • 30 fps • 25.4 MB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🔄 Change Video" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11.5" Click="GifChangeVideo_Click"/>
                                </Grid>
                            </Border>

                            <!-- Video Preview Player Card -->
                            <Border Background="#0E0E12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Video Viewport with Interactive Crop Overlay -->
                                    <Border Background="#000000" CornerRadius="8" Height="300" ClipToBounds="True" Margin="0,0,0,12">
                                        <Grid x:Name="GifPlayerViewportGrid" SizeChanged="GifPlayerViewportGrid_SizeChanged">
                                            <!-- Video Player -->
                                            <MediaElement x:Name="GifMediaPlayer" 
                                                          LoadedBehavior="Manual" 
                                                          UnloadedBehavior="Stop" 
                                                          MediaOpened="GifPlayer_MediaOpened" 
                                                          MediaEnded="GifPlayer_MediaEnded" 
                                                          Stretch="Uniform" 
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>

                                            <!-- Dedicated Frame Preview Image (Scrubbing / Seeking / Paused) -->
                                            <Image x:Name="GifFramePreviewImage" 
                                                   Stretch="Uniform" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" 
                                                   Visibility="Collapsed" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                                            <!-- Crop Overlay Canvas -->
                                            <Canvas x:Name="GifCropCanvas" ClipToBounds="True" Visibility="Visible">
                                                <!-- Dimmed Shroud Outside Crop Box -->
                                                <Rectangle x:Name="CropMaskTop" Fill="#90000000" IsHitTestVisible="False"/>
                                                <Rectangle x:Name="CropMaskBottom" Fill="#90000000" IsHitTestVisible="False"/>
                                                <Rectangle x:Name="CropMaskLeft" Fill="#90000000" IsHitTestVisible="False"/>
                                                <Rectangle x:Name="CropMaskRight" Fill="#90000000" IsHitTestVisible="False"/>

                                                <!-- The Resizable Crop Box -->
                                                <Border x:Name="CropBoxBorder" BorderBrush="#38BDF8" BorderThickness="2" Background="#01FFFFFF">
                                                    <!-- Inside the crop box: Grid with Rule of Thirds guidelines and Center Drag Thumb -->
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Subtle rule-of-thirds lines -->
                                                        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                                        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
                                                        <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
                                                        <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>

                                                        <!-- Center Drag Thumb to move the whole crop rectangle -->
                                                        <Thumb x:Name="CropCenterThumb" Grid.RowSpan="3" Grid.ColumnSpan="3" Style="{StaticResource CropCenterThumbStyle}" Cursor="SizeAll" DragDelta="CropCenter_DragDelta" ToolTip="Drag to move crop area"/>

                                                        <!-- Dimension Tag Badge inside crop box -->
                                                        <Border x:Name="CropDimensionBadge" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#D918181B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False">
                                                            <TextBlock x:Name="CropDimensionText" Text="512 × 512" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 4 Edge Handles -->
                                                <Thumb x:Name="CropHandleTop" Style="{StaticResource CropEdgeThumbStyle}" Width="28" Height="8" Cursor="SizeNS" DragDelta="CropEdge_DragDelta" Tag="Top" ToolTip="Drag top border"/>
                                                <Thumb x:Name="CropHandleBottom" Style="{StaticResource CropEdgeThumbStyle}" Width="28" Height="8" Cursor="SizeNS" DragDelta="CropEdge_DragDelta" Tag="Bottom" ToolTip="Drag bottom border"/>
                                                <Thumb x:Name="CropHandleLeft" Style="{StaticResource CropEdgeThumbStyle}" Width="8" Height="28" Cursor="SizeWE" DragDelta="CropEdge_DragDelta" Tag="Left" ToolTip="Drag left border"/>
                                                <Thumb x:Name="CropHandleRight" Style="{StaticResource CropEdgeThumbStyle}" Width="8" Height="28" Cursor="SizeWE" DragDelta="CropEdge_DragDelta" Tag="Right" ToolTip="Drag right border"/>

                                                <!-- 4 Corner Handles (Moves 2 sides simultaneously) -->
                                                <Thumb x:Name="CropHandleTopLeft" Style="{StaticResource CropCornerThumbStyle}" Width="12" Height="12" Cursor="SizeNWSE" DragDelta="CropCorner_DragDelta" Tag="TopLeft" ToolTip="Drag corner"/>
                                                <Thumb x:Name="CropHandleTopRight" Style="{StaticResource CropCornerThumbStyle}" Width="12" Height="12" Cursor="SizeNESW" DragDelta="CropCorner_DragDelta" Tag="TopRight" ToolTip="Drag corner"/>
                                                <Thumb x:Name="CropHandleBottomLeft" Style="{StaticResource CropCornerThumbStyle}" Width="12" Height="12" Cursor="SizeNESW" DragDelta="CropCorner_DragDelta" Tag="BottomLeft" ToolTip="Drag corner"/>
                                                <Thumb x:Name="CropHandleBottomRight" Style="{StaticResource CropCornerThumbStyle}" Width="12" Height="12" Cursor="SizeNWSE" DragDelta="CropCorner_DragDelta" Tag="BottomRight" ToolTip="Drag corner"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- Interactive Crop Toolbar -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Preset Ratio Buttons -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✂️ Crop:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="Full (Reset)" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="GifCropRatioFull_Click" ToolTip="Reset to 100% full original video"/>
                                            <Button Content="1:1 (Square)" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="GifCropRatio1x1_Click" ToolTip="Snap crop to 1:1 square (optimal for stickers)"/>
                                            <Button Content="16:9" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="GifCropRatio16x9_Click" ToolTip="Snap crop to 16:9 widescreen"/>
                                            <Button Content="9:16" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="GifCropRatio9x16_Click" ToolTip="Snap crop to 9:16 vertical / reel"/>
                                            <Button Content="4:3" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Click="GifCropRatio4x3_Click" ToolTip="Snap crop to 4:3 standard"/>
                                        </StackPanel>

                                        <!-- Live Crop Info Badge -->
                                        <TextBlock x:Name="GifCropInfoText" Grid.Column="2" Text="Full frame: Original" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Player Controls Bar -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Transport Controls (Jump Start, Step Back, Play/Pause, Step Forward, Jump End) -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <!-- Jump to Clip / Video Start -->
                                            <Button x:Name="GifJumpStartBtn" 
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="30" 
                                                    Height="32" 
                                                    Padding="0" 
                                                    Margin="0,0,4,0" 
                                                    Click="GifJumpStart_Click" 
                                                    ToolTip="Jump to beginning of video (00:00)">
                                                <TextBlock Text="⏮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Step -0.1s (-1 frame) -->
                                            <Button x:Name="GifStepBackBtn" 
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="32" 
                                                    Height="32" 
                                                    Padding="0" 
                                                    Margin="0,0,4,0" 
                                                    Click="GifStepBack_Click" 
                                                    ToolTip="Step back 0.1s">
                                                <TextBlock Text="◀" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Play/Pause Button -->
                                            <Button x:Name="GifPlayPauseButton" 
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="38" 
                                                    Height="32" 
                                                    Padding="0" 
                                                    Margin="0,0,4,0" 
                                                    Click="GifPlayPause_Click" 
                                                    ToolTip="Play / Pause">
                                                <TextBlock x:Name="GifPlayPauseIcon" Text="▶" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Step +0.1s (+1 frame) -->
                                            <Button x:Name="GifStepForwardBtn" 
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="32" 
                                                    Height="32" 
                                                    Padding="0" 
                                                    Margin="0,0,4,0" 
                                                    Click="GifStepForward_Click" 
                                                    ToolTip="Step forward 0.1s">
                                                <TextBlock Text="▶" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Jump to Clip / Video End -->
                                            <Button x:Name="GifJumpEndBtn" 
                                                    Style="{StaticResource SecondaryButton}" 
                                                    Width="30" 
                                                    Height="32" 
                                                    Padding="0" 
                                                    Click="GifJumpEnd_Click" 
                                                    ToolTip="Jump to end of video">
                                                <TextBlock Text="⏭" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Interactive Timeline Scrubber with Visual Trim Range Highlight -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="26" SizeChanged="GifTimelineGrid_SizeChanged">
                                            <!-- Canvas for Trim Region Highlight on track -->
                                            <Canvas x:Name="GifTimelineTrackCanvas" ClipToBounds="True" Height="6" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Rectangle x:Name="GifTimelineTrimHighlight" Fill="#38BDF8" Opacity="0.45" Height="6" RadiusX="3" RadiusY="3" Canvas.Left="0" Canvas.Top="0" Width="0"/>
                                            </Canvas>

                                            <!-- Scrubber Slider with IsMoveToPointEnabled="True" -->
                                            <Slider x:Name="GifPlayerScrubber" 
                                                    Minimum="0" 
                                                    Maximum="100" 
                                                    Value="0" 
                                                    IsMoveToPointEnabled="True"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    PreviewMouseDown="GifPlayerScrubber_PreviewMouseDown"
                                                    PreviewMouseUp="GifPlayerScrubber_PreviewMouseUp"
                                                    ValueChanged="GifPlayerScrubber_ValueChanged"
                                                    Style="{StaticResource TimelineSliderStyle}"/>
                                        </Grid>

                                        <!-- Current / Total Time -->
                                        <TextBlock x:Name="GifPlayerTimeText" 
                                                   Grid.Column="2" 
                                                   Text="00:00 / 00:00" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center" 
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Interactive Precision Trimming Section -->
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CLIP TRIMMING RANGE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <!-- Loop Preview Button -->
                                        <Button Grid.Column="1" Content="🔁 Preview Clip Loop" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Click="GifPreviewLoop_Click" ToolTip="Play loop strictly between Start and End"/>
                                    </Grid>

                                    <!-- Start and End Controls -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Start Time -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="START TIME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GifStartTimeTextBox" Grid.Column="0" Text="00:00.00" Style="{StaticResource TrimTimeTextBox}" Height="38" Background="#18181B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" FontSize="13.5" FontWeight="SemiBold" LostFocus="GifStartTimeTextBox_LostFocus" KeyDown="GifTimeTextBox_KeyDown"/>
                                                <Button Grid.Column="1" Content="👁️ Seek" Style="{StaticResource SecondaryButton}" Height="38" Padding="8,0" Margin="6,0,0,0" FontSize="11" Click="GifSeekToStartTime_Click" ToolTip="Seek player to Clip Start"/>
                                                <Button Grid.Column="2" Content="[ Set Current" Style="{StaticResource SecondaryButton}" Height="38" Padding="10,0" Margin="6,0,0,0" FontSize="11" Click="GifSetCurrentAsStart_Click" ToolTip="Set current player time as clip start"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- End Time -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="END TIME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GifEndTimeTextBox" Grid.Column="0" Text="00:05.00" Style="{StaticResource TrimTimeTextBox}" Height="38" Background="#18181B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" FontSize="13.5" FontWeight="SemiBold" LostFocus="GifEndTimeTextBox_LostFocus" KeyDown="GifTimeTextBox_KeyDown"/>
                                                <Button Grid.Column="1" Content="👁️ Seek" Style="{StaticResource SecondaryButton}" Height="38" Padding="8,0" Margin="6,0,0,0" FontSize="11" Click="GifSeekToEndTime_Click" ToolTip="Seek player to Clip End"/>
                                                <Button Grid.Column="2" Content="Set Current ]" Style="{StaticResource SecondaryButton}" Height="38" Padding="10,0" Margin="6,0,0,0" FontSize="11" Click="GifSetCurrentAsEnd_Click" ToolTip="Set current player time as clip end"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Selected Clip Duration Badge -->
                                    <Border Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <TextBlock x:Name="GifClipDurationBadge" Text="Selected Clip: 5.00s (120 frames @ 24 fps)" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Format and Presets Card -->
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT FORMAT &amp; PRESET" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <!-- Format Radio Buttons -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="GifFormatGifRadio" Grid.Column="0" Content="Animated GIF (.gif)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Checked="GifFormat_Checked"/>
                                        <RadioButton x:Name="GifFormatWebpRadio" Grid.Column="1" Content="Animated WebP (.webp)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Checked="GifFormat_Checked"/>
                                        <RadioButton x:Name="GifFormatTelegramRadio" Grid.Column="2" Content="Telegram Sticker (.webm)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Checked="GifFormat_Checked" ToolTip="Official Telegram Video Sticker specification (VP9, 512px box, &lt; 256 KB, no audio)"/>
                                    </Grid>

                                    <!-- Telegram Video Sticker Notice Banner -->
                                    <Border x:Name="GifTelegramNoticeCard" Background="#132A38" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="✈️ Telegram Video Sticker Mode Active" Foreground="#38BDF8" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Snap 1:1 Square" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="11" Click="GifCropRatio1x1_Click" ToolTip="Center 1:1 square crop for sticker"/>
                                            </Grid>
                                            <TextBlock Text="Generates VP9 WebM conforming to Telegram @Stickers bot (/newvideo): 512px bounding box, no audio, and &lt; 256 KB." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="GifTelegramDurationWarning" Text="⚠️ Note: Telegram video stickers must be 3.0 seconds or less. Output clip will automatically be capped to 3.0s." Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Preset Selector -->
                                    <TextBlock Text="Preset Profile" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="GifPresetComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="GifPresetComboBox_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="🌟 Maximum Quality (High-Fidelity, 256 colors / Lossless WebP)"/>
                                        <ComboBoxItem Content="⚖️ Balanced (Discord &amp; Web Sharing, 720p / 24fps)"/>
                                        <ComboBoxItem Content="🗜️ Maximum Compression (Compact Sticker / Emoji, 256px / 15fps)"/>
                                        <ComboBoxItem Content="🎯 Target File Size (Auto-calculate to fit MB limit)"/>
                                        <ComboBoxItem Content="⚙️ Custom Parameters (Full Manual Control)"/>
                                    </ComboBox>

                                    <!-- Target Size Panel (Visible only when preset is Target Size) -->
                                    <Border x:Name="GifTargetSizePanel" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Target File Size Limit (MB):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="Automatically tunes resolution and fps so clip stays under limit" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBox x:Name="GifTargetSizeTextBox" Grid.Column="1" Text="10" Style="{StaticResource ModernTextBox}" Width="70" Height="36" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Collapsible Detailed Parameters Drawer -->
                                    <Border x:Name="GifDropdownBorder" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <StackPanel>
                                            <!-- Drawer Header Toggle Button -->
                                            <Button x:Name="GifToggleSettingsButton" 
                                                    Click="GifToggleSettings_Click"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="14,10"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚙️ Advanced Parameters (FPS, Resolution, Speed, Dithering)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="GifDropdownArrow" Grid.Column="1" Text="▼" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>

                                            <!-- Collapsible Panel Content -->
                                            <Border x:Name="GifDetailedSettingsPanel" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="16" Visibility="Collapsed">
                                                <StackPanel x:Name="GifOptionsPanel">
                                                    <!-- Row 1: FPS and Resolution -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Frame Rate (FPS) -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Frame Rate (FPS)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifFpsComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="1">
                                                                <ComboBoxItem Content="60 fps (Ultra Smooth)" Tag="60"/>
                                                                <ComboBoxItem Content="30 fps (Smooth - Recommended)" Tag="30"/>
                                                                <ComboBoxItem Content="24 fps (Cinematic Standard)" Tag="24"/>
                                                                <ComboBoxItem Content="20 fps (Web Optimized)" Tag="20"/>
                                                                <ComboBoxItem Content="15 fps (Compact Standard)" Tag="15"/>
                                                                <ComboBoxItem Content="12 fps (Low Bandwidth)" Tag="12"/>
                                                                <ComboBoxItem Content="10 fps (Sticker / Minimal)" Tag="10"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <!-- Resolution / Scale -->
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Resolution / Width" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifResolutionComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                                <ComboBoxItem Content="Original Resolution" Tag="0"/>
                                                                <ComboBoxItem Content="1080p (Full HD)" Tag="1080"/>
                                                                <ComboBoxItem Content="720p (HD)" Tag="720"/>
                                                                <ComboBoxItem Content="480p (Standard)" Tag="480"/>
                                                                <ComboBoxItem Content="360p (Compact)" Tag="360"/>
                                                                <ComboBoxItem Content="256px (Emoji / Sticker)" Tag="256"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Row 2: Speed and Looping -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Speed Multiplier -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Playback Speed" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifSpeedComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="2">
                                                                <ComboBoxItem Content="0.5x (Slow Motion)" Tag="0.5"/>
                                                                <ComboBoxItem Content="0.75x (Slower)" Tag="0.75"/>
                                                                <ComboBoxItem Content="1.0x (Normal Speed)" Tag="1.0"/>
                                                                <ComboBoxItem Content="1.25x (Faster)" Tag="1.25"/>
                                                                <ComboBoxItem Content="1.5x (Fast)" Tag="1.5"/>
                                                                <ComboBoxItem Content="2.0x (Double Speed)" Tag="2.0"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <!-- Looping -->
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Loop Mode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifLoopComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                                <ComboBoxItem Content="Infinite Loop (Standard)" Tag="0"/>
                                                                <ComboBoxItem Content="Play Once (No Loop)" Tag="-1"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- GIF Specific: Dithering and Max Colors -->
                                                    <Grid x:Name="GifDitherPanel" Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Dithering -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="GIF Dithering Mode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifDitherComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                                <ComboBoxItem Content="Sierra2_4a (Smoothest Gradients)" Tag="sierra2_4a"/>
                                                                <ComboBoxItem Content="Bayer (Compact / Structured)" Tag="bayer"/>
                                                                <ComboBoxItem Content="Floyd-Steinberg (Crisp)" Tag="floyd_steinberg"/>
                                                                <ComboBoxItem Content="None (Solid Colors, Smallest Size)" Tag="none"/>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <!-- Colors -->
                                                        <StackPanel x:Name="GifColorsPanel" Grid.Column="2">
                                                            <TextBlock Text="Color Palette Size" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <ComboBox x:Name="GifColorsComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                                <ComboBoxItem Content="256 Colors (Maximum Fidelity)" Tag="256"/>
                                                                <ComboBoxItem Content="128 Colors (Optimized)" Tag="128"/>
                                                                <ComboBoxItem Content="64 Colors (Compact)" Tag="64"/>
                                                                <ComboBoxItem Content="32 Colors (Minimal Size)" Tag="32"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- WebP Specific: Quality Slider & Lossless -->
                                                    <StackPanel x:Name="GifWebpQualityPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="WebP Visual Quality" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock x:Name="GifWebpQualityValueText" Grid.Column="1" Text="Quality: 80%" Foreground="#38BDF8" FontSize="11" FontWeight="Bold"/>
                                                        </Grid>
                                                        <Slider x:Name="GifWebpQualitySlider" Minimum="10" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="GifWebpQualitySlider_ValueChanged" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="GifWebpLosslessCheckBox" Content="Lossless Compression Mode" Style="{StaticResource ModernCheckBox}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Destination Folder & Output File Preview -->
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="OUTPUT DESTINATION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="GifDestinationTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#18181B" Foreground="White" BorderBrush="{StaticResource BorderBrush}" FontSize="12.5" TextChanged="GifDestinationTextBox_TextChanged"/>
                                        <Button Grid.Column="1" Content="Browse Custom..." Style="{StaticResource SecondaryButton}" Padding="12,0" Height="38" Margin="8,0,0,0" Click="GifBrowseDestination_Click"/>
                                        <Button Grid.Column="2" Content="Reset" Style="{StaticResource SecondaryButton}" Padding="12,0" Height="38" Margin="8,0,0,0" Click="GifResetDestination_Click"/>
                                    </Grid>
                                    <Border Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Output file:  " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="GifOutputPreviewText" Grid.Column="1" Text="[Destination Preview]" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Live Progress Panel (Visible while encoding) -->
                            <Border x:Name="GifProgressPanel" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GifProgressText" Grid.Column="0" Text="Encoding frames..." Foreground="#38BDF8" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="GifCancelButton" Grid.Column="1" Content="✕ Cancel" Style="{StaticResource DangerButton}" Padding="12,4" FontSize="11" Click="GifCancelButton_Click"/>
                                    </Grid>
                                    <ProgressBar x:Name="GifProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#F43F5E" Background="#27272A"/>
                                </StackPanel>
                            </Border>

                            <!-- Completed Card (Visible on success) -->
                            <Border x:Name="GifCompletionCard" Background="#14281E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Clip Created Successfully!" Foreground="#34D399" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock x:Name="GifCompletedFileNameText" Text="Clip_Name.gif" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="GifCompletedSizeText" Text="File size: 1.2 MB • Time spent: 1.4s" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="GifOpenCompletedFileButton" Content="▶ Open File" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0" Click="GifOpenCompletedFile_Click"/>
                                        <Button x:Name="GifOpenCompletedFolderButton" Content="📂 Open Folder" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Click="GifOpenCompletedFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Create Action Button -->
                            <Button x:Name="GifCreateButton" 
                                    Content="🎞️ Create GIF Clip" 
                                    Style="{StaticResource ModernButton}" 
                                    Height="48" 
                                    Width="260" 
                                    HorizontalAlignment="Center" 
                                    Click="GifCreateButton_Click"
                                    Margin="0,0,0,20"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Download Queue View (Full-Page Responsive View) -->
                <ScrollViewer x:Name="QueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,24,76,36" MaxWidth="900" HorizontalAlignment="Stretch">
                        
                        <!-- Top Responsive Navigation Bar -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,20">
                            <Button DockPanel.Dock="Left"
                                    Content="← Back to Downloader" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="14,8" 
                                    FontSize="12.5" 
                                    Click="BackFromQueue_Click" 
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,6"/>

                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="📋 Batch Import" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Padding="12,8" 
                                        FontSize="12" 
                                        Margin="0,0,8,6"
                                        Click="BatchImportFromQueue_Click"
                                        ToolTip="Import more links into the queue"/>
                                <Button Content="🧹 Clear Finished" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Padding="12,8" 
                                        FontSize="12" 
                                        Margin="0,0,8,6"
                                        Click="ClearCompletedQueue_Click"
                                        ToolTip="Remove completed, failed and canceled items from list"/>
                                <Button Content="⏹ Cancel All" 
                                        Style="{StaticResource MinimalistCancelButton}" 
                                        Padding="12,8" 
                                        FontSize="12" 
                                        Margin="0,0,0,6"
                                        Click="CancelAllQueue_Click"
                                        ToolTip="Cancel all pending and active downloads"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- Header & Summary Card -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="28,24" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="📥" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Download Queue" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="QueueStatusCountTextBlock" 
                                               Text="0 Downloading • 0 Queued • 0 Completed" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="13"/>
                                </StackPanel>

                                <!-- Automatic Power Management Card on Queue Completion -->
                                <Border Grid.Column="1" Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="QueueAutoPowerCheckBox" 
                                                  Style="{StaticResource ModernCheckBox}" 
                                                  Content="⏻ When finished:" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,10,0"
                                                  ToolTip="Automatically trigger selected power action when download queue completes"/>
                                        <ComboBox x:Name="QueueAutoPowerActionComboBox" 
                                                  Style="{StaticResource ModernComboBox}" 
                                                  Width="125" 
                                                  Height="36" 
                                                  Padding="12,6" 
                                                  FontSize="12" 
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Shut down"/>
                                            <ComboBoxItem Content="Sleep"/>
                                            <ComboBoxItem Content="Hibernate"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Empty State Panel -->
                        <Border x:Name="QueueEmptyStatePanel" 
                                Background="{StaticResource SurfaceBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="16" 
                                Padding="40" 
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.7"/>
                                <TextBlock Text="Download Queue is Empty" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Add single URLs from the main window or use Batch Import to queue multiple links." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16" TextAlignment="Center"/>
                                <Button Content="📋 Open Batch Import" 
                                        Style="{StaticResource ModernButton}" 
                                        Padding="20,10" 
                                        FontSize="13" 
                                        HorizontalAlignment="Center" 
                                        Click="BatchImportFromQueue_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Items Control -->
                        <ItemsControl x:Name="QueueItemsControl" Margin="0,4,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161A" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="18,14" 
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Icon / Badge -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- Info & Progress -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Action Buttons -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Status / Platform Badge -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding PlatformBadgeBg}" 
                                                    CornerRadius="8" 
                                                    Width="52" 
                                                    Height="38" 
                                                    Margin="0,0,14,0" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PlatformBadgeText}" 
                                                           Foreground="{Binding PlatformBadgeFg}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           Padding="2,0"/>
                                            </Border>

                                            <!-- Center: Title, Progress, Status -->
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Title -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding Title}" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="13.5" 
                                                           FontWeight="SemiBold" 
                                                           TextTrimming="CharacterEllipsis" 
                                                           TextWrapping="NoWrap"
                                                           ToolTip="{Binding Title}"
                                                           Margin="0,0,0,5"/>
                                                
                                                <!-- Progress Bar -->
                                                <ProgressBar Grid.Row="1"
                                                             Value="{Binding Progress}" 
                                                             Maximum="100" 
                                                             Height="6" 
                                                             Margin="0,0,0,6" 
                                                             Style="{StaticResource ModernProgressBar}"/>

                                                <!-- Status & URL line -->
                                                <Grid Grid.Row="2">
                                                    <TextBlock Text="{Binding StatusText}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                                               FontSize="11.5" 
                                                               HorizontalAlignment="Left"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" 
                                                               Foreground="#71717A" 
                                                               FontSize="11" 
                                                               HorizontalAlignment="Right" 
                                                               TextTrimming="CharacterEllipsis" 
                                                               MaxWidth="300"/>
                                                </Grid>
                                            </Grid>

                                            <!-- Right: Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Cancel Button (when queued or downloading) -->
                                                <Button Content="✕ Cancel" 
                                                        Padding="10,6" 
                                                        FontSize="11.5" 
                                                        Tag="{Binding Id}" 
                                                        Click="QueueCancelItem_Click"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MinimalistCancelButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Retry Button (when failed or canceled) -->
                                                <Button Content="🔄 Retry" 
                                                        Padding="10,6" 
                                                        FontSize="11.5" 
                                                        Tag="{Binding Id}" 
                                                        Click="QueueRetryItem_Click"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Play Preview Button (when completed) -->
                                                <Button Content="▶ Play" 
                                                        Padding="10,6" 
                                                        FontSize="11.5" 
                                                        Tag="{Binding}" 
                                                        Click="QueuePlayPreview_Click"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Open Folder Button (when completed) -->
                                                <Button Content="📂 Folder" 
                                                        Padding="10,6" 
                                                        FontSize="11.5" 
                                                        Tag="{Binding}" 
                                                        Click="QueueOpenFolder_Click"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Delete / Remove Button -->
                                                <Button Content="🗑" 
                                                        Style="{StaticResource MinimalistCancelButton}" 
                                                        Padding="8,6" 
                                                        FontSize="12" 
                                                        Tag="{Binding Id}" 
                                                        Click="QueueDeleteItem_Click" 
                                                        ToolTip="Remove from queue"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Music & Video Search View (Responsive Card Grid) -->
                <ScrollViewer x:Name="SearchScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,24,76,36" MaxWidth="1050" HorizontalAlignment="Stretch">
                        
                        <!-- Top Navigation Bar -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,20">
                            <Button DockPanel.Dock="Left"
                                    Content="← Back to Downloader" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="14,8" 
                                    FontSize="12.5" 
                                    Click="BackFromSearch_Click" 
                                    VerticalAlignment="Center"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SearchStatsTextBlock" 
                                           Text="Search across YouTube &amp; SoundCloud" 
                                           Foreground="#D4D4D8" 
                                           FontSize="12.5" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Search Bar Header Card -->
                        <Border Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="16" 
                                Padding="20,18" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <!-- Search Mode Selection Tabs -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="SearchModeSmartMusicTab" 
                                                 Content="🎵 Smart Music Hub" 
                                                 GroupName="SearchModeGroup" 
                                                 IsChecked="True" 
                                                 Style="{StaticResource FilterChipStyle}" 
                                                 FontSize="12.5" 
                                                 Padding="14,7" 
                                                 Margin="0,0,8,0" 
                                                 Click="SearchModeTab_Click" 
                                                 Tag="SmartMusic"
                                                 ToolTip="Multi-source parallel music search across YouTube &amp; SoundCloud with smart fallback"/>

                                    <RadioButton x:Name="SearchModeRealYouTubeTab" 
                                                 Content="📺 Real YouTube Search" 
                                                 GroupName="SearchModeGroup" 
                                                 Style="{StaticResource FilterChipStyle}" 
                                                 FontSize="12.5" 
                                                 Padding="14,7" 
                                                 Click="SearchModeTab_Click" 
                                                 Tag="RealYouTube"
                                                 ToolTip="Direct authentic YouTube video search with pure query ranking &amp; full metadata"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="SearchQueryTextBox" 
                                             Grid.Column="0"
                                             Style="{StaticResource ModernTextBox}" 
                                             Text="Search track, artist, music name or album..."
                                             KeyDown="SearchQueryTextBox_KeyDown"
                                             GotFocus="SearchQueryTextBox_GotFocus"
                                             LostFocus="SearchQueryTextBox_LostFocus"
                                             PreviewMouseDown="SearchQueryTextBox_PreviewMouseDown"
                                             TextChanged="SearchQueryTextBox_TextChanged"/>

                                    <Button Grid.Column="1" 
                                            x:Name="ShazamIdentifyButton"
                                            Content="🎙️ Shazam (5s)" 
                                            ToolTip="Record 5s from Microphone or PC Audio to identify any song"
                                            Style="{StaticResource ModernButton}" 
                                            Height="48" 
                                            Padding="18,0" 
                                            Margin="10,0,0,0"
                                            Background="#1E1E24"
                                            BorderBrush="#38BDF8"
                                            BorderThickness="1"
                                            Click="ShazamIdentifyButton_Click"/>

                                    <Button Grid.Column="2" 
                                            x:Name="ExecuteSearchButton"
                                            Content="🔍 Search" 
                                            Style="{StaticResource ModernButton}" 
                                            Height="48" 
                                            Padding="24,0" 
                                            Margin="10,0,0,0"
                                            Click="ExecuteSearchButton_Click"/>
                                </Grid>

                                <!-- Shazam Listening Card -->
                                <Border x:Name="ShazamListeningBorder" 
                                        Background="#181820" 
                                        BorderBrush="#38BDF8" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="16,12" 
                                        Margin="0,14,0,0" 
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="🎙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="ShazamStatusTextBlock" Text="Listening to audio... (5s)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Audio level meter -->
                                        <ProgressBar Grid.Column="1" x:Name="ShazamAudioLevelProgressBar" Height="6" Minimum="0" Maximum="1" Value="0" Foreground="#38BDF8" Background="#262626" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                        <!-- Audio Source Toggle -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <RadioButton x:Name="ShazamSourceSystem" Content="🔊 PC Audio" GroupName="ShazamSourceGroup" IsChecked="True" Style="{StaticResource FilterChipStyle}" Margin="0,0,6,0"/>
                                            <RadioButton x:Name="ShazamSourceMic" Content="🎤 Mic" GroupName="ShazamSourceGroup" Style="{StaticResource FilterChipStyle}"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="✖ Cancel" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" FontSize="11" Click="ShazamCancel_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Filter Chips -->
                                <WrapPanel x:Name="SearchPlatformFilterPanel" Margin="0,14,0,0" Orientation="Horizontal">
                                    <TextBlock Text="Source:" Foreground="#D4D4D8" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                                    <RadioButton x:Name="SearchFilterAll" Content="All Sources" GroupName="SearchPlatformGroup" IsChecked="True" Style="{StaticResource FilterChipStyle}" Click="SearchFilter_Click" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="SearchFilterYouTube" Content="🔴 YouTube" GroupName="SearchPlatformGroup" Style="{StaticResource FilterChipStyle}" Click="SearchFilter_Click" Margin="0,0,8,0"/>
                                    <RadioButton x:Name="SearchFilterSoundCloud" Content="🟠 SoundCloud" GroupName="SearchPlatformGroup" Style="{StaticResource FilterChipStyle}" Click="SearchFilter_Click" Margin="0,0,8,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Search Loading / Status Spinner -->
                        <Border x:Name="SearchLoadingBorder" 
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="12" 
                                Padding="24,20" 
                                Margin="0,0,0,20" 
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Style="{StaticResource ModernProgressBar}" Width="260" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SearchLoadingTextBlock" Text="Searching YouTube &amp; SoundCloud..." Foreground="#D4D4D8" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty / Initial Hint State -->
                        <Border x:Name="SearchEmptyStateBorder" 
                                Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="16" 
                                Padding="40" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                Margin="0,20,0,0" 
                                Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🎵" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Search Any Song, Artist or Video" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Find music across YouTube &amp; SoundCloud instantly without opening a browser." Foreground="#D4D4D8" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                
                                <!-- Quick Search Tags -->
                                <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Content="🔥 Trending Music" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="4" Click="QuickSearchTag_Click"/>
                                    <Button Content="🎧 Phonk" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="4" Click="QuickSearchTag_Click"/>
                                    <Button Content="☕ Lo-Fi Beats" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="4" Click="QuickSearchTag_Click"/>
                                    <Button Content="🎹 Synthwave" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="4" Click="QuickSearchTag_Click"/>
                                    <Button Content="🎸 Rock Hits" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="4" Click="QuickSearchTag_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Results Grid -->
                        <ItemsControl x:Name="SearchResultsItemsControl" Margin="0,0,0,24">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="14" 
                                            Width="300" 
                                            Margin="8,8,8,8" 
                                            Padding="12" 
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- Thumbnail Area -->
                                            <Grid Height="160" Margin="0,0,0,10">
                                                <Border CornerRadius="10" ClipToBounds="True" Background="#09090B">
                                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Duration Badge (Bottom Right) -->
                                                <Border Background="#D009090B" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
                                                    <TextBlock Text="{Binding DurationString}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>

                                                <!-- Platform Badge (Top Left) -->
                                                <Border Background="{Binding PlatformBadgeBackground}" BorderBrush="{Binding PlatformBadgeColor}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                    <TextBlock Text="{Binding Platform}" Foreground="{Binding PlatformBadgeColor}" FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Title & Artist -->
                                            <TextBlock Text="{Binding Title}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontSize="13.5" 
                                                       FontWeight="SemiBold" 
                                                       TextWrapping="Wrap" 
                                                       MaxHeight="38" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       ToolTip="{Binding Title}" 
                                                       Margin="0,0,0,4"/>

                                            <TextBlock Text="{Binding ArtistOrChannel}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       FontSize="12" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       ToolTip="{Binding ArtistOrChannel}" 
                                                       Margin="0,0,0,10"/>

                                            <!-- Quick Action / Options Toggle -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Options Toggle Button (for YouTube) / Direct Download Button (for SoundCloud) -->
                                                <Button Grid.Column="0" 
                                                        Content="⚙️ Download Options ▾" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Height="34" 
                                                        Padding="10,0" 
                                                        FontSize="12" 
                                                        Margin="0,0,6,0" 
                                                        Tag="{Binding}" 
                                                        Click="SearchItemOptionsToggle_Click"/>

                                                <!-- Quick Queue Button -->
                                                <Button Grid.Column="1" 
                                                        Content="➕ Queue" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Height="34" 
                                                        Padding="12,0" 
                                                        FontSize="12" 
                                                        Tag="{Binding}" 
                                                        Click="SearchItemAddToQueue_Click" 
                                                        ToolTip="Add directly to Download Queue"/>
                                            </Grid>

                                            <!-- Expanded Custom Select Settings (YouTube / SoundCloud) -->
                                            <Border Background="#1F1F24" 
                                                    BorderBrush="{StaticResource PrimaryBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="10" 
                                                    Padding="10" 
                                                    Margin="0,8,0,0" 
                                                    Visibility="{Binding IsOptionsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="SELECT QUALITY / FORMAT:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <ComboBox Style="{StaticResource ModernComboBox}" 
                                                              ItemsSource="{Binding AvailableQualities}" 
                                                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}" 
                                                              DisplayMemberPath="Label" 
                                                              Height="36" 
                                                              Padding="8,4" 
                                                              FontSize="12" 
                                                              Margin="0,0,0,10"/>

                                                    <UniformGrid Columns="2">
                                                        <Button Content="⬇ Download" 
                                                                Style="{StaticResource ModernButton}" 
                                                                Height="32" 
                                                                Padding="0" 
                                                                FontSize="12" 
                                                                Margin="0,0,4,0" 
                                                                Tag="{Binding}" 
                                                                Click="SearchItemStartDownload_Click"/>
                                                        <Button Content="➕ To Queue" 
                                                                Style="{StaticResource SecondaryButton}" 
                                                                Height="32" 
                                                                Padding="0" 
                                                                FontSize="12" 
                                                                Margin="4,0,0,0" 
                                                                Tag="{Binding}" 
                                                                Click="SearchItemAddToQueueWithOptions_Click"/>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

                <!-- Live Stream / DJ Scraper View -->
                <ScrollViewer x:Name="LiveStreamScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="32,24,76,36" MaxWidth="1050" HorizontalAlignment="Stretch">
                        
                        <!-- Top Navigation Bar -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,20">
                            <Button DockPanel.Dock="Left"
                                    Content="← Back to Downloader" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="14,8" 
                                    FontSize="12.5" 
                                    Click="BackFromLiveStream_Click" 
                                    VerticalAlignment="Center"/>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="LiveStreamToggleSessionsButton" 
                                        Content="📜 Past Sessions" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Padding="14,8" 
                                        FontSize="12" 
                                        Margin="0,0,10,0"
                                        Click="LiveStreamToggleSessionsButton_Click"/>
                                <Button x:Name="LiveStreamDownloadAllButton" 
                                        Content="⬇ Download All (0)" 
                                        Style="{StaticResource ModernButton}" 
                                        Padding="16,8" 
                                        FontSize="12" 
                                        Click="LiveStreamDownloadAllButton_Click"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Header Control Card -->
                        <Border Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="16" 
                                Padding="24,20" 
                                BorderThickness="1" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="📻" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Live Stream / DJ Scraper" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Continuously recognizes and logs all songs playing on your PC in real time without duplicates." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                                    </StackPanel>

                                    <!-- Hotkey Badge -->
                                    <Border Grid.Column="1" Background="#181824" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Hotkey: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="LiveStreamHotkeyBadgeTextBlock" Text="[F9]" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Big Toggle Button and Status Controls -->
                                <Border Background="#121218" CornerRadius="12" Padding="18,14" Margin="0,16,0,0" BorderBrush="#27272A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Start / Stop Button -->
                                        <Button Grid.Column="0" 
                                                x:Name="LiveStreamToggleButton"
                                                Content="🎙️ Start Listening (PC Audio)"
                                                Style="{StaticResource ModernButton}"
                                                Height="48"
                                                Padding="22,0"
                                                FontSize="13.5"
                                                FontWeight="Bold"
                                                Click="LiveStreamToggleButton_Click"/>

                                        <!-- Status Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,20,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse x:Name="LiveStreamStatusPulseDot" Width="10" Height="10" Fill="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LiveStreamStatusTextBlock" Text="⚪ Ready — Click Start Listening or press F9" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="LiveStreamAudioLevelProgressBar" Height="4" Minimum="0" Maximum="1" Value="0" Foreground="#10B981" Background="#262626"/>
                                        </StackPanel>

                                        <!-- Session Stats -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock x:Name="LiveStreamTrackCountTextBlock" Text="0 tracks detected" FontWeight="Bold" FontSize="14" Foreground="#10B981" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="LiveStreamSessionTimeTextBlock" Text="Session: 00:00" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Past Sessions Panel (Collapsible) -->
                        <Border x:Name="LiveStreamSessionsBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="#38BDF8" Margin="0,0,0,20" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📜 Past Listening Sessions" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕ Close" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Click="LiveStreamCloseSessions_Click"/>
                                </Grid>
                                <ItemsControl x:Name="LiveStreamSessionsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161E" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#272732" BorderThickness="1">
                                                <StackPanel>
                                                    <!-- Session Header Row (Clickable) -->
                                                    <Grid Cursor="Hand" MouseLeftButtonUp="LiveStreamSessionHeader_MouseLeftButtonUp" Tag="{Binding}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ExpandToggleIcon}" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding FormattedDate}" FontWeight="Bold" FontSize="13.5" Foreground="White"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Tracks.Count, StringFormat='{}Tracks: {0} songs detected'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="18,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{Binding ExpandToggleText}" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" FontSize="11" Margin="0,0,8,0" Click="LiveStreamTogglePastSessionExpand_Click" Tag="{Binding}"/>
                                                            <Button Content="📂 Load Tracks" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" FontSize="11" Margin="0,0,8,0" Click="LiveStreamLoadPastSession_Click" Tag="{Binding}"/>
                                                            <Button Content="⬇ Download All" Style="{StaticResource ModernButton}" Height="32" Padding="12,0" FontSize="11" Click="LiveStreamDownloadPastSession_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Dropdown Individual Tracks Accordion -->
                                                    <Border Margin="0,12,0,0" Padding="12,12,12,4" Background="#111116" CornerRadius="8" BorderBrush="#20202C" BorderThickness="1"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisConverter}}">
                                                        <StackPanel>
                                                            <TextBlock Text="🎵 Songs in this session:" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="4,0,0,8"/>
                                                            <ItemsControl ItemsSource="{Binding Tracks}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#1A1A24" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="#2A2A38" BorderThickness="1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <!-- Time badge -->
                                                                                <Border Grid.Column="0" Background="#242432" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA"/>
                                                                                </Border>
                                                                                <!-- Song Title & Artist -->
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                                <!-- Actions for this single song -->
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                                    <Button Content="⬇ Download MP3" 
                                                                                            Style="{StaticResource ModernButton}" 
                                                                                            Height="28" 
                                                                                            Padding="10,0" 
                                                                                            FontSize="11" 
                                                                                            Margin="0,0,6,0"
                                                                                            Click="LiveStreamTrackDownload_Click" 
                                                                                            Tag="{Binding}"/>
                                                                                    <Button Content="➕ Queue" 
                                                                                            Style="{StaticResource SecondaryButton}" 
                                                                                            Height="28" 
                                                                                            Padding="8,0" 
                                                                                            FontSize="11" 
                                                                                            Margin="0,0,6,0"
                                                                                            Click="LiveStreamTrackAddToQueue_Click" 
                                                                                            Tag="{Binding}"/>
                                                                                    <Button Content="🔍 Search" 
                                                                                            Style="{StaticResource SecondaryButton}" 
                                                                                            Height="28" 
                                                                                            Padding="8,0" 
                                                                                            FontSize="11" 
                                                                                            Click="LiveStreamTrackSearch_Click" 
                                                                                            Tag="{Binding}"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Live Detected Tracks Real-Time Feed -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎵 Real-Time Detected Tracklist" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="🗑️ Clear List" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Click="LiveStreamClearCurrentList_Click"/>
                                </Grid>

                                <!-- Empty State -->
                                <Border x:Name="LiveStreamEmptyStateBorder" Padding="40,30" HorizontalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎧" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="No songs detected yet" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Play music on your PC and click 'Start Listening' (or press F9)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Real-time Track List -->
                                <ItemsControl x:Name="LiveStreamTracksItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#16161E" CornerRadius="12" Padding="14" Margin="0,0,0,10" BorderBrush="#272732" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Timestamp Badge -->
                                                    <Border Grid.Column="0" Background="#242432" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA"/>
                                                    </Border>

                                                    <!-- Track Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <Button Content="⬇ Download MP3" 
                                                                Style="{StaticResource ModernButton}" 
                                                                Height="34" 
                                                                Padding="14,0" 
                                                                FontSize="11.5" 
                                                                Margin="0,0,8,0"
                                                                Click="LiveStreamTrackDownload_Click" 
                                                                Tag="{Binding}"/>

                                                        <Button Content="➕ Queue" 
                                                                Style="{StaticResource SecondaryButton}" 
                                                                Height="34" 
                                                                Padding="12,0" 
                                                                FontSize="11.5" 
                                                                Margin="0,0,8,0"
                                                                Click="LiveStreamTrackAddToQueue_Click" 
                                                                Tag="{Binding}"/>

                                                        <Button Content="🔍 Search" 
                                                                Style="{StaticResource SecondaryButton}" 
                                                                Height="34" 
                                                                Padding="10,0" 
                                                                FontSize="11.5" 
                                                                Click="LiveStreamTrackSearch_Click" 
                                                                Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Floating Media Preview Player Bar -->
                <Border x:Name="BottomPlayerBar" 
                        VerticalAlignment="Bottom"
                        Height="72"
                        Background="#121118"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed"
                        Panel.ZIndex="30"
                        Effect="{StaticResource CardShadow}">
                    <Grid Margin="20,0,20,0">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Track Title & Badge -->
                            <ColumnDefinition Width="240"/>
                            <!-- Center: Controls & Seek Bar -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Volume & Close -->
                            <ColumnDefinition Width="210"/>
                        </Grid.ColumnDefinitions>

                        <!-- Track Info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="PlayerTitleTextBlock" 
                                       Text="Track Title" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="Hand"
                                       ToolTip="Click to copy title"
                                       MouseLeftButtonUp="PlayerTitleTextBlock_MouseLeftButtonUp"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border x:Name="PlayerPlatformBadge" Background="#208B5CF6" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                    <TextBlock x:Name="PlayerPlatformTextBlock" Text="Media" Foreground="{StaticResource PrimaryHoverBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="PlayerFormatTextBlock" Text="MP3" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Playback Controls + Seek Bar -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Center Controls -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                <Button x:Name="PlayerPlayPauseButton" 
                                        Width="34" 
                                        Height="34" 
                                        Content="⏸"
                                        Foreground="White"
                                        FontSize="13"
                                        Click="PlayerPlayPauseButton_Click" 
                                        Cursor="Hand"
                                        ToolTip="Play / Pause">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{StaticResource PrimaryBrush}" CornerRadius="17">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Seek Slider & Timestamp -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerCurrentTimeTextBlock" Grid.Column="0" Text="00:00" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="PlayerSeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" PreviewMouseDown="PlayerSeekSlider_PreviewMouseDown" PreviewMouseUp="PlayerSeekSlider_PreviewMouseUp" Style="{StaticResource ModernSliderStyle}"/>
                                <TextBlock x:Name="PlayerTotalTimeTextBlock" Grid.Column="2" Text="00:00" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>

                        <!-- Volume & Close Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Modern Volume Pill -->
                            <Border Background="#18181B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayerMuteButton" 
                                            Content="🔊" 
                                            Background="Transparent" 
                                            Foreground="{StaticResource TextPrimaryBrush}" 
                                            BorderThickness="0" 
                                            FontSize="13" 
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Cursor="Hand" 
                                            Click="PlayerMuteButton_Click" 
                                            ToolTip="Mute / Unmute"/>
                                    <Slider x:Name="PlayerVolumeSlider" 
                                            Width="74" 
                                            Minimum="0" 
                                            Maximum="1" 
                                            Value="0.8" 
                                            SmallChange="0.05"
                                            LargeChange="0.1"
                                            Style="{StaticResource VolumeSliderStyle}" 
                                            VerticalAlignment="Center" 
                                            ValueChanged="PlayerVolumeSlider_ValueChanged" 
                                            Margin="4,0,4,0" 
                                            ToolTip="Volume: 80%"/>
                                </StackPanel>
                            </Border>
                            <!-- Open external file button -->
                            <Button Content="↗" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="PlayerOpenExternal_Click" ToolTip="Open with system default app" Margin="0,0,8,0"/>
                            <!-- Close Player Bar -->
                            <Button Content="✕" Style="{StaticResource MinimalistCancelButton}" Width="28" Height="28" FontSize="12" Click="PlayerClose_Click" ToolTip="Close preview player"/>
                        </StackPanel>
                    </Grid>
                </Border>

