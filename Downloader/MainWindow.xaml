                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Badge Counter -->
                                <Border x:Name="QueueBadgeBorder" 
                                        Background="#EF4444" 
                                        CornerRadius="9" 
                                        MinWidth="18" 
                                        Height="18" 
                                        Padding="4,0"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Top" 
                                        Margin="0,-3,-3,0"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="QueueBadgeTextBlock" 
                                               Text="0" 
                                               Foreground="White" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- EXPANDED STATE (Full Drawer Panel) -->
                        <Grid x:Name="SpotifyExpandedView" Visibility="Collapsed" Opacity="0" Margin="16,20,16,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Spotify Icon + Text + Collapse Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Clicking the top Spotify logo will collapse it! -->
                                <Button x:Name="SpotifyExpandedHeaderButton"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        Click="SpotifyExpandedHeaderButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Path Width="32" Height="32" Stretch="Uniform" Fill="#1DB954"
                                                  Data="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424c-.18.295-.565.387-.86.207-2.377-1.454-5.37-1.783-8.893-1.007-.336.075-.67-.14-.744-.477-.074-.336.14-.67.477-.744 3.844-.877 7.143-.5 9.843 1.15.295.18.387.565.207.86zm1.223-2.72c-.226.367-.707.487-1.074.26-2.72-1.672-6.87-2.157-10.082-1.182-.413.125-.85-.107-.975-.52-.125-.413.107-.85.52-.975 3.678-1.117 8.243-.57 11.35 1.343.367.227.487.708.26 1.074zm.107-2.82C14.792 8.98 9.68 8.81 6.74 9.7c-.476.143-.982-.123-1.127-.6-.143-.475.124-.982.6-1.126 3.407-1.033 9.04-.842 12.63 1.287.428.254.57.802.315 1.23-.254.428-.802.57-1.23.315z"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="SPOTIFY IMPORT" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="Playlist CSV Importer" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                </StackPanel>

                                <!-- Close Button on top right -->
                                <Button Grid.Column="2" Content="✕" Style="{StaticResource MinimalistCancelButton}" Click="SpotifyExpandedHeaderButton_Click" Height="28" Width="28" FontSize="12"/>
                            </Grid>

                            <!-- Scrollable Panel Content -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Загрузка плейлистов любого размера через экспорт CSV." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                    <!-- Step 1: Open Exportify -->
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="ШАГ 1: ЭКСПОРТ CSV" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <TextBlock Text="Откройте бесплатный сервис Exportify и скачайте CSV файл вашего плейлиста." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                            <Button Style="{StaticResource SecondaryButton}" Content="Открыть Exportify ↗" Click="OpenExportifyButton_Click" Padding="10,8" FontSize="11" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Step 2: Load CSV -->
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="ШАГ 2: ИМПОРТ ФАЙЛА" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <Button Style="{StaticResource ModernButton}" Content="Выбрать CSV файл" Click="ImportSpotifyCsvButton_Click" Padding="10,8" FontSize="11" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- CSV Info / Status Panel -->
                                    <Border x:Name="SpotifyCsvInfoBorder" Background="#0DFFFFFF" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Visibility="Collapsed" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="ТЕКУЩИЙ ИМПОРТ" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="SpotifyCsvNameText" Text="Playlist Name" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="SpotifyCsvCountText" Text="0 tracks loaded" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Previous Imports Section -->
                                    <Border x:Name="SpotifyImportsBorder" Background="#0DFFFFFF" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="ИМПОРТЫ" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
                                            <ItemsControl x:Name="SpotifyImportsItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SecondaryButton}" 
                                                                Margin="0,0,0,8" 
                                                                Padding="12,10" 
                                                                HorizontalAlignment="Stretch" 
                                                                Click="SpotifyImportItem_Click"
                                                                Tag="{Binding}">
                                                            <Button.Content>
                                                                <Grid HorizontalAlignment="Stretch" Width="240">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Tracks.Count, StringFormat='{}{0} треков'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Button.Content>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ANIME SERIES BATCH DOWNLOAD DRAWER -->
            <Grid x:Name="AnimeDrawerGrid" 
                  Grid.Row="0" 
                  Grid.RowSpan="2" 
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch" 
                  Background="#CC09090D" 
                  Visibility="Collapsed" 
                  Panel.ZIndex="99998">
                <Border Background="#14141A" 
                        BorderBrush="#F43F5E" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Width="620" 
                        MaxHeight="720" 
                        Padding="26" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Direction="0" ShadowDepth="0" Color="#F43F5E" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Anime Poster, Title, and Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Poster thumbnail -->
                            <Border Grid.Column="0" Width="68" Height="96" CornerRadius="8" Background="#20202A" ClipToBounds="True" Margin="0,0,16,0" BorderBrush="#3A3A4A" BorderThickness="1">
                                <Image x:Name="AnimeDrawerPosterImage" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Title & Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AnimeDrawerCategoryText" Text="🎬 СЕРИАЛ / ФИЛЬМ" Foreground="#F43F5E" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AnimeDrawerTitleText" Text="Название Аниме" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

                                <TextBlock x:Name="AnimeDrawerOriginalTitleText" Text="Original Title" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AnimeDrawerMetaText" Text="2024 • 24 серий • ⭐ 8.5" Foreground="{StaticResource SuccessBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource WindowControlButton}" Width="30" Height="30" Click="AnimeDrawerClose_Click" ToolTip="Закрыть"/>
                        </Grid>

                        <!-- Dubbing / Voice Selector Row -->
                        <Border Grid.Row="1" Background="#1A1A24" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="#2A2A38" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="🎙️ Озвучка / Перевод:" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Выберите озвучку для просмотра серий" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"/>
                                </StackPanel>
                                <ComboBox x:Name="AnimeDubsComboBox" 
                                          Grid.Column="1" 
                                          Style="{StaticResource ModernComboBox}"
                                          Height="38" 
                                          FontSize="12.5"
                                          DisplayMemberPath="DisplayBadge"
                                          SelectionChanged="AnimeDubsComboBox_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- Episodes Header & Controls (Select All / Deselect All) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,2,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AnimeSelectedCountText" Grid.Column="0" Text="Выбрано: 24 из 24" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="✓ Выбрать все" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="AnimeSelectAll_Click"/>
                                <Button Grid.Column="2" Content="Снять выбор" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Click="AnimeDeselectAll_Click"/>
                            </Grid>

                            <!-- Scrollable Episodes Checklist -->
                            <Border Grid.Row="1" Background="#0D0D12" CornerRadius="10" Padding="8" BorderBrush="#22222E" BorderThickness="1" MaxHeight="300">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AnimeEpisodesItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#16161E" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="#242432" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource AnimeCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" Checked="AnimeEpisodeCheckbox_Changed" Unchecked="AnimeEpisodeCheckbox_Changed"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="8,3" BorderBrush="#38BDF8" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding QualityBadge}" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Action Buttons Footer -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="AnimeDrawerFallbackText" Text="Автовыбор: 1080p (Cinemar/VideoCDN/Alloha)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <CheckBox x:Name="AnimeDownloadSubsCheckBox" 
                                          Content="Скачивать субтитры (при наличии)" 
                                          Foreground="{StaticResource TextSecondaryBrush}" 
                                          FontSize="11" 
                                          Margin="0,4,0,0" 
                                          IsChecked="True"
                                          ToolTip="Автоматически скачивает файл субтитров (.vtt / .srt) вместе с видео"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource SecondaryButton}" Height="38" Padding="16,0" FontSize="11.5" Margin="0,0,10,0" Click="AnimeDrawerClose_Click"/>
                            <Button x:Name="AnimeDownloadSelectedButton" Grid.Column="2" Content="⬇ Скачать выбранные" Style="{StaticResource ModernButton}" Height="38" Padding="20,0" FontSize="12" FontWeight="Bold" Background="#E11D48" BorderBrush="#F43F5E" Click="AnimeDownloadSelected_Click"/>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>

            <!-- Update Dialog Modal Overlay (Centered over full window) -->
            <Grid x:Name="UpdateDialogOverlay" 
                  Grid.Row="0" 
                  Grid.RowSpan="2" 
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch" 
                  Background="#CC09090D" 
                  Visibility="Collapsed" 
                  Panel.ZIndex="99999">
                <Border Background="#14141A" 
                        BorderBrush="#38BDF8" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Width="540" 
                        MaxHeight="640" 
                        Padding="28" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Direction="0" ShadowDepth="0" Color="#38BDF8" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="New Version Available!" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Current: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="UpdateDialogCurrentVersionTextBlock" Text="v1.0.9" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock Text=" ➔ " FontSize="12" Foreground="#38BDF8" FontWeight="Bold" Margin="4,0"/>
                                    <TextBlock Text="Latest: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="UpdateDialogLatestVersionTextBlock" Text="v1.0.9" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE8BB;" Style="{StaticResource WindowControlButton}" Width="30" Height="30" Click="UpdateDialogClose_Click" ToolTip="Close"/>
                        </Grid>

                        <!-- Release Title / Info -->
                        <Border Background="#1A1A24" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#2A2A38" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="UpdateDialogReleaseTitleTextBlock" Text="Release Title" FontWeight="Bold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="UpdateDialogReleaseDateTextBlock" Text="Published: 2026-08-24" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Changelog / Release Notes -->
                        <TextBlock Text="📋 What's New:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="2,0,0,6"/>
                        <Border Background="#0D0D12" CornerRadius="8" Padding="12" BorderBrush="#22222E" BorderThickness="1" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateDialogNotesTextBlock" Text="Release notes..." TextWrapping="Wrap" FontSize="11.5" Foreground="#CBD5E1" LineHeight="17"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Progress Bar during download -->
                        <StackPanel x:Name="UpdateProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="UpdateProgressStatusTextBlock" Text="Downloading update..." FontSize="11.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateProgressPercentTextBlock" Text="0%" HorizontalAlignment="Right" FontSize="11.5" Foreground="White" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="UpdateDownloadProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="#262630"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🌐 View on GitHub" Style="{StaticResource SecondaryButton}" Height="38" Padding="12,0" FontSize="11.5" HorizontalAlignment="Left" Click="UpdateDialogViewGitHub_Click"/>
                            <Button Grid.Column="1" Content="Later" Style="{StaticResource SecondaryButton}" Height="38" Padding="16,0" FontSize="11.5" Margin="0,0,10,0" Click="UpdateDialogClose_Click"/>
                            <Button x:Name="UpdateDialogApplyButton" Grid.Column="2" Content="⬇ Update &amp; Restart" Style="{StaticResource ModernButton}" Height="38" Padding="18,0" FontSize="12" FontWeight="Bold" Background="#059669" BorderBrush="#10B981" Click="UpdateDialogApply_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>